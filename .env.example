# Copy to .env for local dev and build (gitignored).
# Cloudflare Email Routing must be enabled with verified addresses.
# Sender (from) must be an address on your domain with Email Routing active.
CONTACT_FROM_EMAIL=contacto@davosdo.dev

# Inbox where contact submissions are delivered (must match send_email binding)
CONTACT_TO_EMAIL=hola@davosdo.dev

# Turnstile site key (public). Used by `astro dev` and as a build fallback.
# Production SSR reads PUBLIC_TURNSTILE_SITE_KEY from wrangler.json `vars` (or override there).
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADWPq4baKHGPGw1Z

# Turnstile secret (server-only, never in HTML): wrangler secret put TURNSTILE_SECRET_KEY
# Local preview: copy .dev.vars.example to .dev.vars
