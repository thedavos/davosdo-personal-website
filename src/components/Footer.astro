---
import SocialLinks from "@components/commons/SocialLinks.astro";

const today = new Date();
---

<footer
	class="text-sm px-4 py-8 text-center text-muted bg-[linear-gradient(var(--color-background-gradient))] bg-no-repeat"
>
	<p class="m-0">
		&copy; {today.getFullYear()} David Vargas Domínguez. Desarrollo web,
		automatización e IA aplicada.
	</p>
	<SocialLinks class="mt-2 flex flex-wrap justify-center gap-3" />
</footer>
