---
import HeaderLink from "@components/HeaderLink.astro";
import MobileNav from "@components/commons/MobileNav.vue";
import Logo from "@components/commons/Logo.astro";
import LanguageSwitcher from "@components/commons/LanguageSwitcher.vue";
import { SITE_NAV_ITEMS, SITE_TITLE } from "@/consts";

const currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");
---

<header>
	<div class="border-b border-border bg-surface/95 px-4 shadow-sm md:px-8">
		<nav
			class="mx-auto flex min-h-[61px] w-full max-w-[1180px] items-center justify-between gap-4 md:min-h-[72px] lg:grid lg:grid-cols-[max-content_minmax(0,1fr)_max-content]"
			aria-label="Principal"
		>
			<Logo siteTitle={SITE_TITLE} />
			<div
				class="hidden items-center justify-self-center gap-1 p-1 md:flex"
				aria-label="Secciones"
			>
				{
					SITE_NAV_ITEMS.map((item) => (
						<HeaderLink href={item.url} class="whitespace-nowrap">
							{item.title}
						</HeaderLink>
					))
				}
			</div>
			<div class="hidden items-center justify-self-end md:flex">
				<LanguageSwitcher client:load />
			</div>
			<MobileNav
				client:load
				navItems={SITE_NAV_ITEMS}
				currentPath={currentPath}
			/>
		</nav>
	</div>
</header>
