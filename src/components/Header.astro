---
import HeaderLink from "@components/HeaderLink.astro";
import MobileNav from "@components/commons/MobileNav.vue";
import Logo from "@components/commons/Logo.astro";
import ThemeToggle from "@components/commons/ThemeToggle.astro";
import { SITE_NAV_ITEMS, SITE_TITLE } from "@/consts";

const currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");
---

<header>
	<div class="border-b border-border">
		<nav
			class="site-container flex min-h-[61px] items-center justify-between gap-4 md:min-h-[72px] lg:grid lg:grid-cols-[max-content_minmax(0,1fr)]"
			aria-label="Principal"
		>
			<Logo siteTitle={SITE_TITLE} />
			<div
				class="hidden items-center justify-self-end gap-1 p-1 md:flex"
				aria-label="Secciones"
				data-desktop-navigation
			>
				{
					SITE_NAV_ITEMS.map((item) => (
						<HeaderLink href={item.url} class="whitespace-nowrap">
							{item.title}
						</HeaderLink>
					))
				}
				<HeaderLink href="/#contacto" class="whitespace-nowrap" data-no-swup>
					Hablemos
				</HeaderLink>
				<div class="ml-1 flex items-center">
					<ThemeToggle />
				</div>
			</div>
			<div class="flex items-center md:hidden">
				<MobileNav
					client:media="(max-width: 767px)"
					navItems={SITE_NAV_ITEMS}
					currentPath={currentPath}
				/>
			</div>
		</nav>
	</div>
</header>

<style>
	header {
		font-family: var(--font-geist-sans), sans-serif;
	}
</style>

<script>
	function syncHeaderNavigation() {
		const pathname = window.location.pathname;
		const currentSegment = pathname.match(/[^/]+/)?.[0] ?? "";

		document
			.querySelectorAll<HTMLAnchorElement>("[data-desktop-navigation] a[href]")
			.forEach((link) => {
				const href = link.getAttribute("href");
				const isActive =
					href === pathname || href === `/${currentSegment}`;

				if (isActive) {
					link.setAttribute("aria-current", "page");
				} else {
					link.removeAttribute("aria-current");
				}

				link.classList.toggle("text-primary", isActive);
				link.classList.toggle("font-700", isActive);
				link.classList.toggle("font-semibold", isActive);
			});
	}

	syncHeaderNavigation();

	if (!document.documentElement.dataset.headerNavigationBound) {
		document.documentElement.dataset.headerNavigationBound = "true";
		// `swup:content:replace` is the Swup v4 event name. The v2 spelling,
		// `swup:contentReplaced`, never fired, so the nav only caught up later
		// through `visit:end`, after the transition rather than at the swap.
		document.addEventListener("swup:content:replace", syncHeaderNavigation);
		document.addEventListener("swup:visit:end", syncHeaderNavigation);
		window.addEventListener("popstate", syncHeaderNavigation);
	}
</script>
