---
import Card from "@components/commons/Card.astro";
import Chip from "@components/commons/Chip.astro";

type ExperienceTimelineItem = {
	role: string;
	company: string;
	period: string;
	location?: string;
	description: string;
	highlights?: string[];
	tags?: string[];
};

type Props = {
	items: ExperienceTimelineItem[];
	ariaLabel?: string;
	class?: string;
};

const {
	items,
	ariaLabel = "Experiencia laboral",
	class: className,
} = Astro.props as Props;

const classes = ["timeline", className].filter(Boolean).join(" ");
---

<section class={classes}>
	<ol class="timeline__list" aria-label={ariaLabel}>
		{
			items.map((item, index) => {
				const hasHighlights = Boolean(item.highlights?.length);
				const hasTags = Boolean(item.tags?.length);

				return (
					<li
						class="timeline__item"
						data-cascade-item
						style={`--cascade-delay: ${0.22 + index * 0.08}s`}
					>
						<div class="timeline__content">
							<Card
								as="article"
								variant="outlined"
								padding="none"
								class="service-card-surface service-card-surface-hover box-border min-w-0 p-6 md:p-7"
							>
								<div class="card__header timeline-card__header" slot="header">
									<p class="timeline-card__period">{item.period}</p>
									<h3 class="timeline-card__role">{item.role}</h3>
									<p class="timeline-card__meta">
										<span>{item.company}</span>
										{item.location && (
											<>
												<span aria-hidden="true">/</span>
												<span>{item.location}</span>
											</>
										)}
									</p>
								</div>

								<div class="timeline-card__body">
									<p class="timeline-card__description">{item.description}</p>

									{hasHighlights && (
										<ul class="timeline-card__highlights">
											{item.highlights?.map((highlight) => (
												<li>{highlight}</li>
											))}
										</ul>
									)}
								</div>

								{hasTags && (
									<div class="card__footer timeline-card__footer" slot="footer">
										<ul
											class="timeline-card__tags"
											aria-label={`Tecnologías usadas en ${item.company}`}
										>
											{item.tags?.map((tag) => (
												<li>
													<Chip size="sm" variant="muted">{tag}</Chip>
												</li>
											))}
										</ul>
									</div>
								)}
							</Card>
						</div>
					</li>
				);
			})
		}
	</ol>
</section>

<style>
	.timeline {
		width: 100%;
	}

	.timeline__list {
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		gap: 20px;
		width: 100%;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.timeline__item {
		min-width: 0;
	}

	.timeline__content {
		box-sizing: border-box;
		min-width: 0;
	}

	/* Card separates header, body and footer with a 24px gap plus a ruled
	   padding. Here the company line and the description are one block, so
	   that break reads as a hole. */
	.timeline :global(article.card) {
		gap: 12px;
	}

	.timeline :global(.card__header),
	.timeline :global(.card__footer) {
		padding: 0;
		border: 0;
	}

	.timeline-card__header {
		display: grid;
		gap: 6px;
	}

	.timeline-card__period {
		margin: 0;
		color: rgb(var(--color-text-muted));
		font-family: var(--font-geist-mono), ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
		font-size: 13px;
		font-variant-numeric: tabular-nums;
		font-weight: 400;
		line-height: 1.4;
	}

	.timeline-card__role {
		margin: 0;
		font-size: 16px;
		font-weight: 600;
		line-height: 1.35;
		letter-spacing: 0;
	}

	.timeline-card__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
		color: rgb(var(--color-text-muted));
		font-size: 14px;
		font-weight: 400;
		line-height: 1.45;
	}

	.timeline-card__body {
		display: grid;
		gap: 16px;
		min-width: 0;
	}

	.timeline-card__description {
		margin: 0;
		color: rgb(var(--color-body));
		font-size: 15px;
		line-height: 1.65;
		text-wrap: pretty;
	}

	.timeline-card__highlights {
		display: grid;
		gap: 12px;
		margin: 0;
		padding-left: 20px;
		color: rgb(var(--color-text-muted));
		font-size: 14px;
		line-height: 1.6;
		list-style-type: "–  ";
	}

	.timeline-card__footer {
		justify-content: flex-start;
	}

	.timeline-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

</style>
