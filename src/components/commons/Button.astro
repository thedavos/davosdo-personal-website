---
import type { HTMLAttributes } from "astro/types";

type ButtonElement = "button" | "a";
type ButtonVariant =
	| "primary"
	| "secondary"
	| "outline"
	| "ghost"
	| "link"
	| "destructive";
type ButtonSize = "sm" | "md" | "lg" | "icon";

type BaseProps = {
	as?: ButtonElement;
	href?: string;
	variant?: ButtonVariant;
	size?: ButtonSize;
	fullWidth?: boolean;
	loading?: boolean;
	disabled?: boolean;
	leftIcon?: string;
	rightIcon?: string;
	type?: "button" | "submit" | "reset";
};

type Props = BaseProps & (HTMLAttributes<"button"> | HTMLAttributes<"a">);

const {
	as,
	href,
	variant = "primary",
	size = "md",
	fullWidth = false,
	loading = false,
	disabled = false,
	leftIcon,
	rightIcon,
	class: className,
	type,
	...props
} = Astro.props;

const Component = as ?? (href ? "a" : "button");
const isDisabled = disabled || loading;

const baseClass =
	"button inline-flex items-center justify-center gap-2 rounded-lg border text-sm font-medium no-underline transition-[transform,background-color,border-color,color] duration-150 ease-out select-none whitespace-nowrap focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/35 focus-visible:ring-offset-4 focus-visible:ring-offset-background active:translate-y-[1px] disabled:cursor-not-allowed disabled:opacity-60 cursor-pointer";

const variantClasses: Record<ButtonVariant, string> = {
	primary:
		"border-primary bg-primary text-on-primary hover:border-primary-dark hover:bg-primary-dark",
	secondary:
		"border-border bg-panel text-body hover:border-[var(--color-border-strong)]",
	outline:
		"border-border bg-surface text-body hover:border-[var(--color-border-strong)] hover:bg-[rgb(var(--color-body)/0.04)]",
	ghost:
		"border-transparent bg-transparent text-muted hover:bg-[rgb(var(--color-body)/0.05)] hover:text-body",
	link: "border-transparent bg-transparent px-0 py-0 text-primary rounded-none hover:text-primary-dark hover:underline",
	destructive:
		"border-red-600 bg-red-600 text-white hover:border-red-700 hover:bg-red-700",
};

const sizeButton: Record<ButtonSize, string> = {
	sm: `min-h-9 ${fullWidth ? '' : 'px-4'} py-2 text-sm`,
	md: `min-h-11 ${fullWidth ? '' : 'px-5'} py-3 text-sm`,
	lg: `min-h-12 ${fullWidth ? '' : 'px-6'} py-3 text-base`,
	icon: "h-11 w-11 p-0",
};

const sizeLink: Record<ButtonSize, string> = {
	sm: `min-h-4 ${fullWidth ? '' : 'px-4'} py-2 text-sm`,
	md: `min-h-6 ${fullWidth ? '' : 'px-5'} py-3 text-sm`,
	lg: `min-h-8 ${fullWidth ? '' : 'px-6'} py-3 text-base`,
	icon: "h-11 w-11 p-0",
};

const iconSizeClasses: Record<ButtonSize, string> = {
	sm: "text-base",
	md: "text-lg",
	lg: "text-xl",
	icon: "text-lg",
};

const sizeClasses = Component === "a" ? sizeLink : sizeButton;

const classes = [
	baseClass,
	variantClasses[variant],
	sizeClasses[size],
	fullWidth && "w-full",
	isDisabled && "pointer-events-none",
	className,
]
	.filter(Boolean)
	.join(" ");

const sharedProps = {
	class: classes,
	"data-variant": variant,
	"data-size": size,
	"aria-busy": loading || undefined,
};
---

{
	Component === "a" ? (
		<a
			href={isDisabled ? undefined : href}
			aria-disabled={isDisabled || undefined}
			tabindex={isDisabled ? -1 : undefined}
			{...sharedProps}
			{...props}
		>
			{loading && <span class="button__spinner" aria-hidden="true" />}
			{leftIcon && !loading && (
				<span
					class:list={["button__icon", iconSizeClasses[size], leftIcon]}
					aria-hidden="true"
				/>
			)}
			<span class:list={["button__label", loading && "opacity-80"]}>
				<slot />
			</span>
			{rightIcon && !loading && (
				<span
					class:list={["button__icon", iconSizeClasses[size], rightIcon]}
					aria-hidden="true"
				/>
			)}
		</a>
	) : (
		<button
			type={type ?? "button"}
			disabled={isDisabled}
			{...sharedProps}
			{...props}
		>
			{loading && <span class="button__spinner" aria-hidden="true" />}
			{leftIcon && !loading && (
				<span
					class:list={["button__icon", iconSizeClasses[size], leftIcon]}
					aria-hidden="true"
				/>
			)}
			<span class:list={["button__label", loading && "opacity-80"]}>
				<slot />
			</span>
			{rightIcon && !loading && (
				<span
					class:list={["button__icon", iconSizeClasses[size], rightIcon]}
					aria-hidden="true"
				/>
			)}
		</button>
	)
}

<style>
	.button[data-size="icon"] {
		gap: 0;
	}

	.button__label {
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	.button__icon {
		display: inline-flex;
		flex-shrink: 0;
	}

	.button__spinner {
		display: inline-block;
		width: 1em;
		height: 1em;
		flex-shrink: 0;
		border: 2px solid currentColor;
		border-right-color: transparent;
		border-radius: 999px;
		animation: button-spin 0.7s linear infinite;
	}

	@keyframes button-spin {
		to {
			transform: rotate(360deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.button {
			transition: none;
		}

		.button__spinner {
			animation-duration: 1.4s;
		}
	}
</style>
