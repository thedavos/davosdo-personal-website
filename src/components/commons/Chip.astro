---
import type { HTMLAttributes } from "astro/types";

type ChipElement = "span" | "button";
type ChipVariant = "default" | "primary" | "muted";
type ChipSize = "xs" | "sm" | "md";

type BaseProps = {
	as?: ChipElement;
	variant?: ChipVariant;
	size?: ChipSize;
};

type Props = BaseProps &
	(HTMLAttributes<"span"> | HTMLAttributes<"button">);

const {
	as = "span",
	variant = "default",
	size = "md",
	class: className,
	...props
} = Astro.props as Props;

const Component = as;
---

<Component
	class:list={["chip", `chip--${variant}`, `chip--${size}`, className]}
	{...props}
>
	<slot />
</Component>

<style>
	.chip {
		display: inline-flex;
		align-items: center;
		border-radius: 999px;
		border: 1px solid;
		font-weight: 500;
		line-height: 1;
		white-space: nowrap;
	}

	/* Sizes */
	.chip--xs {
		min-height: 20px;
		padding: 4px 8px;
		font-size: 10px;
	}

	.chip--sm {
		min-height: 24px;
		padding: 4px 8px;
		font-size: 12px;
	}

	.chip--md {
		min-height: 32px;
		padding: 4px 12px;
		font-size: 14px;
	}

	/* Variants */
	.chip--default,
	.chip--muted {
		border-color: rgb(var(--color-secondary)/ 0.14);
		background: rgb(var(--color-secondary)/ 0.08);
		color: rgb(var(--color-text-muted));
	}

	.chip--primary {
		border-color: var(--color-primary-border);
		background: var(--color-primary-soft);
		color: rgb(var(--color-primary));
	}
</style>
