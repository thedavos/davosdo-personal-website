---

<button
	data-theme-toggle
	class="theme-toggle inline-flex h-11 w-11 cursor-pointer items-center justify-center rounded-lg border border-transparent bg-transparent p-0 text-muted transition-colors duration-150 ease-out hover:bg-[rgb(var(--color-body)/0.05)] hover:text-body focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/35 focus-visible:ring-offset-4 focus-visible:ring-offset-background"
	aria-label="Cambiar tema"
	aria-keyshortcuts="T"
	title="Cambiar tema (T)"
	type="button"
>
	<span class="theme-toggle__icon theme-toggle__icon--sun i-lucide-sun text-[18px]" aria-hidden="true"></span>
	<span class="theme-toggle__icon theme-toggle__icon--moon i-lucide-moon text-[18px]" aria-hidden="true"></span>
</button>

<style>
	.theme-toggle__icon {
		display: inline-flex;
	}

	.theme-toggle__icon--moon {
		display: none;
	}

	html[data-theme="dark"] .theme-toggle__icon--sun {
		display: none;
	}

	html[data-theme="dark"] .theme-toggle__icon--moon {
		display: inline-flex;
	}

	@media (prefers-reduced-motion: reduce) {
		.theme-toggle {
			transition: none;
		}
	}
</style>
