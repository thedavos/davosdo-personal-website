---
---

<button
	id="theme-toggle"
	class="flex h-10 w-10 items-center justify-center rounded-xl border border-border bg-surface text-body transition-all hover:border-primary/30 hover:bg-slate-50 hover:text-primary active:scale-95"
	aria-label="Cambiar tema"
>
	<span class="i-lucide-sun block dark:hidden text-lg"></span>
	<span class="i-lucide-moon hidden dark:block text-lg"></span>
</button>

<script>
	const themeToggle = document.getElementById("theme-toggle");

	const getTheme = () => {
		if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
			return localStorage.getItem("theme");
		}
		return window.matchMedia("(prefers-color-scheme: dark)").matches
			? "dark"
			: "light";
	};

	const setTheme = (theme: string) => {
		document.documentElement.setAttribute("data-theme", theme);
		localStorage.setItem("theme", theme);

		// Opcional: Para que UnoCSS dark mode funcione si se usa
		if (theme === "dark") {
			document.documentElement.classList.add("dark");
		} else {
			document.documentElement.classList.remove("dark");
		}
	};

	// Inicializar
	setTheme(getTheme()!);

	themeToggle?.addEventListener("click", () => {
		const currentTheme = document.documentElement.getAttribute("data-theme");
		const newTheme = currentTheme === "dark" ? "light" : "dark";
		setTheme(newTheme);
	});

	// Escuchar cambios de Swup para re-inicializar si es necesario
	document.addEventListener("swup:contentReplaced", () => {
		// El botón podría haber cambiado en el DOM, volvemos a vincular
		const newToggle = document.getElementById("theme-toggle");
		newToggle?.addEventListener("click", () => {
			const currentTheme = document.documentElement.getAttribute("data-theme");
			const newTheme = currentTheme === "dark" ? "light" : "dark";
			setTheme(newTheme);
		});
	});
</script>

<style>
	/* Animación suave para el cambio de colores */
	:global(body) {
		transition: background-color 0.3s ease, color 0.3s ease;
	}
</style>
