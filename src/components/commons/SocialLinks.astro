---
import type { HTMLAttributes } from "astro/types";
import Button from "@components/commons/Button.astro";
import BskyIcon from "@components/icons/BskyIcon.astro";
import HackTheBoxIcon from "@components/icons/HackTheBoxIcon.astro";
import XIcon from "@components/icons/XIcon.astro";
import {
	socialLinks,
	type SocialIconComponent,
	type SocialLink,
} from "@data/social-links";

interface Props extends HTMLAttributes<"div"> {
	links?: SocialLink[];
}

const iconComponents: Record<
	SocialIconComponent,
	typeof XIcon | typeof BskyIcon | typeof HackTheBoxIcon
> = {
	x: XIcon,
	bluesky: BskyIcon,
	hackthebox: HackTheBoxIcon,
};

const { class: className, links = socialLinks, ...props } = Astro.props;
---

<div class:list={[className]} {...props}>
	{
		links.map((social) => {
			const Icon = social.iconComponent
				? iconComponents[social.iconComponent]
				: undefined;

			return (
				<Button
					as="a"
					href={social.href}
					variant="ghost"
					size="icon"
					aria-label={social.label}
					title={social.label}
					target={social.external ? "_blank" : undefined}
					rel={social.external ? "noreferrer" : undefined}
					leftIcon={social.icon}
				>
					{Icon && <Icon />}
				</Button>
			);
		})
	}
	<slot />
</div>
