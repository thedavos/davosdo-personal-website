---
import type { HTMLAttributes } from "astro/types";
import Chip from "@components/commons/Chip.astro";

type Props = {
	value: string;
	selected?: boolean;
} & HTMLAttributes<"button">;

const {
	value,
	selected = false,
	class: className,
	...props
} = Astro.props as Props;

const classes = [
	"selectable-chip min-h-9 cursor-pointer select-none",
	"transition-[transform,background-color,border-color,color,box-shadow] duration-150 ease-out",
	"hover:border-[var(--color-border-strong)] hover:bg-[rgb(var(--color-body)/0.04)]",
	"focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/35 focus-visible:ring-offset-2 focus-visible:ring-offset-surface",
	"active:translate-y-[1px]",
	className,
]
	.filter(Boolean)
	.join(" ");
---

<Chip
	as="button"
	type="button"
	variant="default"
	size="md"
	class={classes}
	aria-pressed={selected}
	data-project-filter-chip
	data-filter-value={value}
	{...props}
>
	<slot />
</Chip>

<style is:global>
	/* Selected reads through weight and border, not fill: quieter than an
	   accent-colored chip and consistent with the neutral chrome. */
	.selectable-chip[aria-pressed="true"] {
		border-color: rgb(var(--color-body));
		background: transparent;
		color: rgb(var(--color-body));
		font-weight: 600;
	}

	@media (prefers-reduced-motion: reduce) {
		.selectable-chip {
			transition: none;
		}
	}
</style>
