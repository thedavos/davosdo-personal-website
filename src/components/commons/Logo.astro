---
interface Props {
	siteTitle: string;
}

const { siteTitle } = Astro.props;
---

<h2 class="m-0 text-xl font-bold">
	<a href="/" class="flex items-center gap-2 py-4 text-logo">
		<span>{siteTitle}</span>
		<span class="h-2 w-2 rounded-full bg-primary self-center" aria-hidden="true"></span>
	</a>
</h2>
