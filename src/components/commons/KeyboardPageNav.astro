---
import type { NavigationItem } from "@/types";
import { getCircularNavItems } from "@/utils/navigation";

interface Props {
	navItems: NavigationItem[];
	currentPath: string;
}

const { navItems, currentPath } = Astro.props;

const { previousItem, nextItem } = getCircularNavItems(navItems, currentPath);

const keyClass =
	"relative inline-flex h-10 w-10 items-center justify-center rounded-lg border border-border bg-surface text-muted shadow-[inset_0_-2px_0_var(--color-card-border),0_1px_3px_var(--color-card-border)] transition-all duration-200";
const enabledKeyClass =
	"cursor-pointer hover:-translate-y-0.5 hover:border-primary/40 hover:text-primary hover:shadow-[inset_0_-2px_0_var(--color-primary-soft),0_2px_6px_var(--color-primary-soft)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30 focus-visible:ring-offset-1 focus-visible:ring-offset-background active:translate-y-0 active:shadow-[inset_0_1px_2px_var(--color-card-border)]";
---

<nav
	class="keyboard-nav fixed inset-x-0 bottom-4 z-[1000000] flex flex-col items-center gap-2 px-4 md:bottom-5"
	aria-label="Navegación con teclado"
	data-keyboard-page-nav
	data-previous-url={previousItem?.url}
	data-next-url={nextItem?.url}
>
	<span class="hidden text-[11px] font-medium text-muted/70 md:inline">
		Navega con tu teclado
	</span>
	<span class="text-[11px] font-medium text-muted/70 md:hidden">
		Desliza para navegar
	</span>
	<div class="flex items-center gap-2">
	{
		previousItem && (
			<a
				href={previousItem.url}
				class:list={[keyClass, enabledKeyClass]}
				aria-label={`Ir a ${previousItem.title}`}
				data-keyboard-page-nav-previous
			>
				<span class="i-lucide-chevron-left h-4 w-4" aria-hidden="true" />
				<span class="sr-only">Anterior: {previousItem.title}</span>
			</a>
		)
	}
	{
		nextItem && (
			<a
				href={nextItem.url}
				class:list={[keyClass, enabledKeyClass]}
				aria-label={`Ir a ${nextItem.title}`}
				data-keyboard-page-nav-next
			>
				<span class="i-lucide-chevron-right h-4 w-4" aria-hidden="true" />
				<span class="sr-only">Siguiente: {nextItem.title}</span>
			</a>
		)
	}
	</div>
</nav>

<style>
	.keyboard-nav {
		animation: nav-fade-in 0.8s ease 1.5s both;
	}

	@keyframes nav-fade-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 0.45;
		}
	}

	.keyboard-nav:hover {
		animation: none;
		opacity: 1;
		transition: opacity 0.2s ease;
	}
</style>
