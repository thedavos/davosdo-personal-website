---
import type { HTMLAttributes } from "astro/types";

type CardElement = "div" | "a" | "article";
type CardVariant = "default" | "elevated" | "outlined" | "interactive";
type CardPadding = "none" | "sm" | "md" | "lg";

type BaseProps = {
	as?: CardElement;
	href?: string;
	variant?: CardVariant;
	padding?: CardPadding;
	fullWidth?: boolean;
};

type Props = BaseProps & (HTMLAttributes<"div"> | HTMLAttributes<"a"> | HTMLAttributes<"article">);

const {
	as,
	href,
	variant = "default",
	padding = "md",
	fullWidth = false,
	class: className,
	...props
} = Astro.props;

const Component = as ?? (href ? "a" : "div");

const hasHeader = Astro.slots.has("header");
const hasFooter = Astro.slots.has("footer");
const isSectioned = hasHeader || hasFooter;

const baseClass =
	"card box-border min-w-0 rounded-lg border border-[var(--color-card-border)] bg-surface transition-[border-color,background-color,box-shadow] duration-200 ease-out";

const variantClasses: Record<CardVariant, string> = {
	default: "",
	elevated:
		"hover:border-[var(--color-border-strong)]",
	outlined: "border-[var(--color-border)]",
	interactive:
		"cursor-pointer hover:border-[var(--color-border-strong)] hover:bg-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/15 focus-visible:ring-inset",
};

const paddingClasses: Record<CardPadding, string> = {
	none: "",
	sm: "p-4",
	md: "p-6",
	lg: "p-8",
};

const sectionedClass = isSectioned ? "flex flex-col gap-6" : "";

const classes = [
	baseClass,
	variantClasses[variant],
	paddingClasses[padding],
	sectionedClass,
	fullWidth && "w-full",
	className,
]
	.filter(Boolean)
	.join(" ");

const sharedProps = {
	class: classes,
	"data-variant": variant,
};
---

{
	Component === "a" ? (
		<a href={href} {...sharedProps} {...props}>
			{hasHeader && (
				<div class="card__header">
					<slot name="header" />
				</div>
			)}
			<slot />
			{hasFooter && (
				<div class="card__footer">
					<slot name="footer" />
				</div>
			)}
		</a>
	) : Component === "article" ? (
		<article {...sharedProps} {...props}>
			{hasHeader && (
				<div class="card__header">
					<slot name="header" />
				</div>
			)}
			<slot />
			{hasFooter && (
				<div class="card__footer">
					<slot name="footer" />
				</div>
			)}
		</article>
	) : (
		<div {...sharedProps} {...props}>
			{hasHeader && (
				<div class="card__header">
					<slot name="header" />
				</div>
			)}
			<slot />
			{hasFooter && (
				<div class="card__footer">
					<slot name="footer" />
				</div>
			)}
		</div>
	)
}

<style>
	.card__header {
		padding-bottom: 16px;
		border-bottom: 1px solid var(--color-border);
	}

	.card__footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 12px;
		padding-top: 16px;
		border-top: 1px solid var(--color-border);
	}
</style>
