---
import type { HTMLAttributes } from "astro/types";

type CardElement = "div" | "a" | "article";
type CardVariant = "default" | "elevated" | "outlined" | "interactive";
type CardPadding = "none" | "sm" | "md" | "lg";

type BaseProps = {
	as?: CardElement;
	href?: string;
	variant?: CardVariant;
	padding?: CardPadding;
	fullWidth?: boolean;
};

type Props = BaseProps & (HTMLAttributes<"div"> | HTMLAttributes<"a"> | HTMLAttributes<"article">);

const {
	as,
	href,
	variant = "default",
	padding = "md",
	fullWidth = false,
	class: className,
	...props
} = Astro.props;

const Component = as ?? (href ? "a" : "div");

const baseClass = "card rounded-xl bg-surface transition-[transform,border-color,box-shadow] duration-200 ease-out";

const variantClasses: Record<CardVariant, string> = {
	default: "shadow-md",
	elevated: "shadow-md hover:shadow-lg hover:-translate-y-0.5",
	outlined: "border border-border shadow-sm",
	interactive: "shadow-md cursor-pointer hover:shadow-lg hover:-translate-y-0.5 hover:border-primary/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/35 focus-visible:ring-offset-4 focus-visible:ring-offset-background",
};

const paddingClasses: Record<CardPadding, string> = {
	none: "",
	sm: "p-3",
	md: "p-5",
	lg: "p-7",
};

const classes = [
	baseClass,
	variantClasses[variant],
	paddingClasses[padding],
	fullWidth && "w-full",
	className,
]
	.filter(Boolean)
	.join(" ");

const sharedProps = {
	class: classes,
	"data-variant": variant,
};

const hasHeader = Astro.slots.has("header");
const hasFooter = Astro.slots.has("footer");
---

{
	Component === "a" ? (
		<a href={href} {...sharedProps} {...props}>
			{hasHeader && (
				<div class="card__header">
					<slot name="header" />
				</div>
			)}
			<slot />
			{hasFooter && (
				<div class="card__footer">
					<slot name="footer" />
				</div>
			)}
		</a>
	) : Component === "article" ? (
		<article {...sharedProps} {...props}>
			{hasHeader && (
				<div class="card__header">
					<slot name="header" />
				</div>
			)}
			<slot />
			{hasFooter && (
				<div class="card__footer">
					<slot name="footer" />
				</div>
			)}
		</article>
	) : (
		<div {...sharedProps} {...props}>
			{hasHeader && (
				<div class="card__header">
					<slot name="header" />
				</div>
			)}
			<slot />
			{hasFooter && (
				<div class="card__footer">
					<slot name="footer" />
				</div>
			)}
		</div>
	)
}

<style>
	.card__header {
		padding-bottom: 16px;
		border-bottom: 1px solid rgba(71, 85, 105, 0.08);
	}

	.card__footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 12px;
		padding-top: 16px;
		border-top: 1px solid rgba(71, 85, 105, 0.08);
	}
</style>
