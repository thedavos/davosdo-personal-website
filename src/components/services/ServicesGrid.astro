---
import Button from "@components/commons/Button.astro";
import Card from "@components/commons/Card.astro";
import Chip from "@components/commons/Chip.astro";
import type { Service } from "@data/services";

type Props = {
	services: Service[];
};

const { services } = Astro.props as Props;
---

<div class="services-grid" aria-label="Servicios">
	{
		services.map(({ title, slug, description, chips, icon }, index) => (
			<Card
				as="article"
				variant="outlined"
				padding="none"
				class="service-card service-card-surface service-card-surface-hover"
				data-cascade-item
				style={`--cascade-delay: ${0.1 + index * 0.06}s`}
			>
				<div class="card__header" slot="header">
					<div class="service-card__title-row">
						<span class:list={["service-card__icon", icon]} aria-hidden="true" />
						<h3 class="service-card__title">{title}</h3>
					</div>
				</div>

				<div class="service-card__body">
					<p class="service-card__description">{description}</p>
					<ul
						class="service-card__chips"
						aria-label={`Tecnologías para ${title}`}
					>
						{chips.map((chip) => (
							<li>
								<Chip size="sm">{chip}</Chip>
							</li>
						))}
					</ul>

					<div class="mt-auto flex justify-end">
						<Button
							as="a"
							href={`/?service=${slug}#contacto`}
							variant="ghost"
							size="sm"
							rightIcon="i-lucide-arrow-right"
							class="-mr-4"
							data-no-swup
						>
							Hablemos
						</Button>
					</div>
				</div>
			</Card>
		))
	}
</div>

<style>
	.services-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 20px;
		margin-bottom: 48px;
	}

	.service-card {
		min-width: 0;
		min-height: 280px;
		padding: 24px;
	}

	.service-card__title-row {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.service-card__icon {
		display: inline-flex;
		flex-shrink: 0;
		width: 1.35rem;
		height: 1.35rem;
		color: rgb(var(--color-primary));
	}

	.service-card__title {
		margin: 0;
		font-size: 22px;
		line-height: 1.15;
		letter-spacing: -0.015em;
	}

	.service-card__body {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 20px;
		min-width: 0;
	}

	.service-card__description {
		max-width: 35ch;
		margin: 0;
		color: rgb(var(--color-text-muted));
		font-size: 15px;
		line-height: 1.6;
	}

	.service-card__chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	@media (max-width: 760px) {
		.service-card {
			min-height: auto;
			padding: 20px;
		}

		.service-card__body {
			gap: 16px;
		}

		.service-card__title {
			font-size: 20px;
		}

		.service-card__description {
			font-size: 14px;
		}
	}
</style>
