---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");
const subpath = pathname.match(/[^\/]+/g);
const isPageActive =
	typeof href === "string" &&
	(href === pathname || href === "/" + (subpath?.[0] || ""));
---

<a
	href={href}
	aria-current={isPageActive ? "page" : undefined}
	class:list={[
		"inline-flex items-center rounded-full px-3 py-2 text-sm font-medium no-underline text-body transition-colors whitespace-nowrap hover:bg-[rgba(99,102,241,0.08)] hover:text-primary focus-visible:outline-[2px] focus-visible:outline-[rgba(99,102,241,0.35)] focus-visible:outline-offset-[3px]",
		className,
		isPageActive && "text-primary font-700 font-semibold",
	]}
	style="letter-spacing: -0.25px;"
	{...props}
>
	<slot />
</a>
