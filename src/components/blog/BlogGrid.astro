---
import BlogFeaturedCard from "@components/blog/BlogFeaturedCard.astro";
import BlogCompactCard from "@components/blog/BlogCompactCard.astro";
import { enrichPost } from "@/lib/blog";
import type { BlogPost } from "@/lib/blog";

type Props = {
	featured?: BlogPost;
	recent: BlogPost[];
};

const { featured, recent } = Astro.props;

const featuredEnriched = featured ? enrichPost(featured) : undefined;
const recentEnriched = recent.map(enrichPost);
const pairedPost = recentEnriched.length === 1 ? recentEnriched[0] : undefined;
const layoutMode =
	recentEnriched.length === 0
		? "solo"
		: pairedPost
			? "pair"
			: "stack";
---

<div
	class:list={["blog-grid", `blog-grid--${layoutMode}`]}
	aria-label="Artículos recientes"
>
	{
		featuredEnriched && (
			<div class="blog-grid__featured">
				<BlogFeaturedCard
					post={featuredEnriched.post}
					readingTimeLabel={featuredEnriched.readingTimeLabel}
					url={featuredEnriched.url}
				/>
			</div>
		)
	}

	{
		pairedPost ? (
			<div class="blog-grid__paired">
				<BlogFeaturedCard
					post={pairedPost.post}
					readingTimeLabel={pairedPost.readingTimeLabel}
					url={pairedPost.url}
				/>
			</div>
		) : (
			<div class="blog-grid__recent">
				{recentEnriched.map((item) => (
					<div class="blog-grid__compact">
						<BlogCompactCard
							post={item.post}
							readingTimeLabel={item.readingTimeLabel}
							url={item.url}
						/>
					</div>
				))}
			</div>
		)
	}
</div>

<style>
	.blog-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 20px;
		align-items: start;
	}

	.blog-grid__featured,
	.blog-grid__paired,
	.blog-grid__compact {
		display: flex;
		flex-direction: column;
		min-width: 0;
		min-height: 0;
	}

	.blog-grid__featured {
		grid-column: 1;
	}

	.blog-grid__paired {
		grid-column: 2;
	}

	.blog-grid__recent {
		display: grid;
		align-content: start;
		gap: 20px;
		grid-column: 2;
		min-width: 0;
	}

	.blog-grid__compact {
		min-height: 128px;
	}

	.blog-grid__featured > :global(*),
	.blog-grid__paired > :global(*),
	.blog-grid__compact > :global(*) {
		flex: 1;
		min-height: 0;
	}

	.blog-grid--solo {
		grid-template-columns: minmax(0, 720px);
		justify-content: center;
	}

	.blog-grid--solo .blog-grid__featured {
		grid-column: 1;
		grid-row: 1;
	}

	.blog-grid--pair {
		align-items: stretch;
	}

	.blog-grid--pair .blog-grid__featured,
	.blog-grid--pair .blog-grid__paired {
		align-self: stretch;
	}

	@media (max-width: 900px) {
		.blog-grid--stack {
			grid-template-columns: 1fr;
		}

		.blog-grid--stack .blog-grid__featured,
		.blog-grid--stack .blog-grid__recent {
			grid-column: 1;
		}

		.blog-grid--stack .blog-grid__recent {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.blog-grid {
			grid-template-columns: 1fr;
		}

		.blog-grid__featured,
		.blog-grid__paired {
			grid-column: 1;
		}

		.blog-grid--stack .blog-grid__recent {
			grid-template-columns: 1fr;
		}
	}
</style>
