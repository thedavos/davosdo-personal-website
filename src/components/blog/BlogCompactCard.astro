---
import Card from "@components/commons/Card.astro";
import BlogPostMeta from "@components/blog/BlogPostMeta.astro";
import type { BlogPost } from "@/lib/blog";

type Props = {
	post: BlogPost;
	readingTimeLabel: string;
	url: string;
	class?: string;
	style?: string;
};

const { post, readingTimeLabel, url, class: className, style } = Astro.props;
const { title, category, pubDate, heroImage } = post.data;
const imageSrc = heroImage ?? "/blog-placeholder.svg";
---

<article class:list={["blog-compact", className]} style={style} data-cascade-item>
	<Card
		as="a"
		href={url}
		variant="interactive"
		padding="none"
		class="service-card-surface service-card-surface-hover blog-compact__card h-full"
	>
		<div class="blog-compact__body">
			<div class="blog-compact__media">
				<img
					src={imageSrc}
					alt=""
					width={80}
					height={80}
					loading="lazy"
					decoding="async"
					class="blog-compact__image"
				/>
			</div>
			<div class="blog-compact__copy">
				<h3 class="blog-compact__title">{title}</h3>
				<BlogPostMeta
					category={category}
					readingTimeLabel={readingTimeLabel}
					pubDate={pubDate}
					variant="inline"
					size="compact"
				/>
			</div>
		</div>
	</Card>
</article>

<style>
	.blog-compact {
		display: flex;
		flex-direction: column;
		min-width: 0;
		min-height: 0;
		height: 100%;
	}

	.blog-compact__card {
		display: flex;
		flex: 1;
		flex-direction: column;
		min-height: 0;
		text-decoration: none;
		color: inherit;
		overflow: hidden;
	}

	.blog-compact__body {
		display: flex;
		flex: 1;
		flex-direction: row;
		align-items: stretch;
		min-height: 0;
		min-width: 0;
		gap: 10px;
	}

	.blog-compact__media {
		flex: 0 0 80px;
		width: 80px;
		overflow: hidden;
	}

	.blog-compact__image {
		display: block;
		width: 100%;
		height: 100%;
		min-height: 100%;
		object-fit: cover;
	}

	.blog-compact__copy {
		display: flex;
		flex: 1;
		flex-direction: column;
		justify-content: center;
		gap: 4px;
		min-width: 0;
	}

	.blog-compact__title {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
		margin: 0;
		font-size: 15px;
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.15;
		text-wrap: balance;
	}
</style>
