---
import Button from "@components/commons/Button.astro";
import Form from "@components/ui/Form.astro";
import FormItem from "@components/ui/FormItem.astro";
import Input from "@components/ui/Input.astro";
import Select from "@components/ui/Select.astro";
import Textarea from "@components/ui/Textarea.astro";
import { contactBudgetOptions } from "@data/contact-budgets";
import { services, getServiceBySlug } from "@data/services";

type Props = {
	selectedService?: string;
	turnstileSiteKey?: string;
};

const { selectedService = "", turnstileSiteKey = "" } = Astro.props;
const validService = getServiceBySlug(selectedService)?.slug ?? "";
---

<div class="form-panel">
	<Form
		class="contact-form gap-8"
		data-contact-form
		data-initial-service={validService}
		data-turnstile-site-key={turnstileSiteKey}
		novalidate
	>
		<input
			type="text"
			name="company_website"
			class="sr-only"
			tabindex="-1"
			autocomplete="off"
			aria-hidden="true"
		/>
		<input type="hidden" name="submit_id" value="" data-submit-id />

		<div class="flex flex-col gap-4">
			<div class="grid min-w-0 gap-6 md:grid-cols-2 md:gap-6">
				<FormItem id="contact-name" label="Nombre" required compact>
					<Input
						id="contact-name"
						type="text"
						name="name"
						size="compact"
						autocomplete="name"
						minlength="2"
						maxlength="80"
						pattern="[A-Za-zÀ-ÖØ-öø-ÿĀ-žḀ-ỿ'’ .-]+"
						required
					/>
				</FormItem>

				<FormItem id="contact-email" label="Email" required compact>
					<Input
						id="contact-email"
						type="email"
						name="email"
						size="compact"
						autocomplete="email"
						inputmode="email"
						maxlength="254"
						required
					/>
				</FormItem>

				<FormItem
					id="contact-service"
					label="¿En qué te puedo ayudar?"
					required
					compact
				>
					<Select id="contact-service" name="service" size="compact" required>
						<option value="" disabled selected={!validService}>
							Selecciona un servicio
						</option>
						{
							services.map(({ slug, title }) => (
								<option value={slug} selected={slug === validService}>
									{title}
								</option>
							))
						}
					</Select>
				</FormItem>

				<FormItem id="contact-budget" label="¿Qué presupuesto tienes?" required compact>
					<Select id="contact-budget" name="budget" size="compact" required>
						<option value="" disabled selected>
							Selecciona un rango
						</option>
						{
							contactBudgetOptions.map(({ value, label }) => (
								<option value={value}>{label}</option>
							))
						}
					</Select>
				</FormItem>

				<div class="md:col-span-2">
					<FormItem id="contact-message" label="Tu mensaje" required compact>
						<Textarea
							id="contact-message"
							name="message"
							size="compact"
							minlength="10"
							maxlength="2000"
							required
						/>
					</FormItem>
				</div>
			</div>

			<div
				class="form-alert hidden"
				data-form-feedback
				role="status"
				aria-live="polite"
			></div>
		</div>

		<div
			class="contact-form__turnstile"
			data-turnstile-container
			aria-label="Verificación de seguridad"
		>
		</div>

		<p class="contact-form__legal">
			Al enviar este formulario, aceptas que trate tus datos para responder a tu
			consulta. Consulta la
			<a href="/privacy-policy/" class="contact-form__legal-link"
				>política de privacidad</a
			>.
		</p>

		<Button
			type="submit"
			size="sm"
			fullWidth
			rightIcon="i-lucide-send"
			data-form-submit
			data-default-label="Enviar mensaje"
		>
			Enviar mensaje
		</Button>
	</Form>
</div>

<style>
	.contact-form__turnstile {
		min-height: 65px;
	}

	.contact-form__legal {
		margin: 0;
		font-size: 0.8125rem;
		line-height: 1.5;
		color: rgb(var(--color-secondary) / 0.85);
	}

	.contact-form__legal-link {
		color: rgb(var(--color-primary));
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.contact-form__legal-link:hover {
		color: rgb(var(--color-primary-dark));
	}

	.contact-form [data-form-submit].is-loading .button__icon {
		display: none;
	}

	.contact-form [data-form-submit].is-loading::before {
		content: "";
		display: inline-block;
		width: 1em;
		height: 1em;
		flex-shrink: 0;
		border: 2px solid currentColor;
		border-right-color: transparent;
		border-radius: 999px;
		animation: contact-form-spin 0.7s linear infinite;
	}

	@keyframes contact-form-spin {
		to {
			transform: rotate(360deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-form [data-form-submit].is-loading::before {
			animation-duration: 1.4s;
		}
	}
</style>

<script>
	const TURNSTILE_SCRIPT_ID = "cf-turnstile-api";

	function ensureTurnstileScript() {
		if (document.getElementById(TURNSTILE_SCRIPT_ID)) {
			return;
		}

		const script = document.createElement("script");
		script.id = TURNSTILE_SCRIPT_ID;
		script.src =
			"https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
		script.async = false;
		document.head.appendChild(script);
	}

	function whenTurnstileReady(callback: () => void) {
		if (typeof turnstile !== "undefined") {
			turnstile.ready(callback);
			return;
		}

		const script = document.getElementById(TURNSTILE_SCRIPT_ID);
		if (!script) {
			callback();
			return;
		}

		script.addEventListener(
			"load",
			() => {
				if (typeof turnstile !== "undefined") {
					turnstile.ready(callback);
				}
			},
			{ once: true },
		);
	}

	function initContactForm(root: HTMLFormElement) {
		if (root.dataset.formInitialized === "true") return;
		root.dataset.formInitialized = "true";

		const turnstileSiteKey = root.dataset.turnstileSiteKey?.trim() ?? "";

		ensureTurnstileScript();

		const feedback = root.querySelector("[data-form-feedback]");
		const submitButtonCandidate = root.querySelector("[data-form-submit]");
		const submitButton =
			submitButtonCandidate instanceof HTMLButtonElement
				? submitButtonCandidate
				: null;
		const submitIdInputCandidate = root.querySelector("[data-submit-id]");
		const submitIdInput =
			submitIdInputCandidate instanceof HTMLInputElement
				? submitIdInputCandidate
				: null;
		const turnstileContainerCandidate = root.querySelector(
			"[data-turnstile-container]",
		);
		const turnstileContainer =
			turnstileContainerCandidate instanceof HTMLElement
				? turnstileContainerCandidate
				: null;
		const serviceSelectCandidate = root.querySelector('select[name="service"]');
		const serviceSelect =
			serviceSelectCandidate instanceof HTMLSelectElement
				? serviceSelectCandidate
				: null;
		const submitLabel = submitButton?.querySelector(".button__label");
		const defaultLabel =
			submitButton?.dataset.defaultLabel ??
			submitLabel?.textContent?.trim() ??
			"Enviar mensaje";

		let isSubmitting = false;
		let turnstileWidgetId: string | null = null;
		let turnstileNeedsRefresh = false;

		const resetTurnstile = () => {
			if (turnstileWidgetId === null || typeof turnstile === "undefined") {
				return;
			}

			turnstile.reset(turnstileWidgetId);
		};

		const refreshTurnstileForNewSubmit = () => {
			if (!turnstileNeedsRefresh) {
				return;
			}

			turnstileNeedsRefresh = false;
			setFeedback(null);
			resetTurnstile();
		};

		const initTurnstile = () => {
			if (!turnstileContainer || !turnstileSiteKey) {
				return;
			}

			if (turnstileContainer.dataset.turnstileMounted === "true") {
				return;
			}

			whenTurnstileReady(() => {
				if (typeof turnstile === "undefined") {
					return;
				}

				if (turnstileContainer.dataset.turnstileMounted === "true") {
					return;
				}

				if (turnstileWidgetId !== null) {
					turnstile.remove(turnstileWidgetId);
					turnstileWidgetId = null;
				}

				turnstileContainer.replaceChildren();

				turnstileWidgetId = turnstile.render(turnstileContainer, {
					sitekey: turnstileSiteKey,
					theme: "auto",
					size: "flexible",
					action: "contact",
				});
				turnstileContainer.dataset.turnstileMounted = "true";
			});
		};

		initTurnstile();

		root.addEventListener("focusin", (event) => {
			const target = event.target;
			if (!(target instanceof HTMLElement)) {
				return;
			}

			if (target.getAttribute("name") === "company_website") {
				return;
			}

			refreshTurnstileForNewSubmit();
		});

		const setSubmitId = () => {
			if (!submitIdInput) return;
			submitIdInput.value = crypto.randomUUID();
		};

		const restoreInitialService = () => {
			const initialService = root.dataset.initialService?.trim();
			if (!initialService || !serviceSelect) return;

			if (
				serviceSelect.querySelector(`option[value="${initialService}"]`) !== null
			) {
				serviceSelect.value = initialService;
			}
		};

		setSubmitId();

		const clearFeedbackClasses = () => {
			if (!(feedback instanceof HTMLElement)) return;
			feedback.classList.remove("form-alert-success", "form-alert-error");
		};

		const setFeedback = (state: "success" | "error" | null, message = ""): void => {
			if (!(feedback instanceof HTMLElement)) return;

			clearFeedbackClasses();

			if (!state) {
				feedback.dataset.state = "";
				feedback.textContent = "";
				feedback.classList.add("hidden");
				return;
			}

			feedback.dataset.state = state;
			feedback.textContent = message;
			feedback.classList.remove("hidden");
			feedback.classList.add(
				state === "success" ? "form-alert-success" : "form-alert-error",
			);
		};

		const setLoading = (loading: boolean): void => {
			if (!submitButton) return;

			submitButton.disabled = loading;
			submitButton.setAttribute("aria-busy", loading ? "true" : "false");
			submitButton.classList.toggle("pointer-events-none", loading);
			submitButton.classList.toggle("is-loading", loading);

			if (submitLabel) {
				submitLabel.textContent = loading ? "Enviando…" : defaultLabel;
			}
		};

		root.addEventListener("submit", async (event) => {
			event.preventDefault();

			if (isSubmitting) {
				return;
			}

			setFeedback(null);

			if (!root.checkValidity()) {
				root.reportValidity();
				return;
			}

			if (turnstileNeedsRefresh) {
				refreshTurnstileForNewSubmit();
			}

			if (
				turnstileWidgetId !== null &&
				typeof turnstile !== "undefined" &&
				!turnstile.getResponse(turnstileWidgetId)
			) {
				setFeedback(
					"error",
					"Completa la verificación de seguridad antes de enviar.",
				);
				return;
			}

			isSubmitting = true;
			const formData = new FormData(root);
			setLoading(true);

			try {
				const response = await fetch("/api/contact", {
					method: "POST",
					body: formData,
				});

				const result = await response.json() as { ok?: boolean; error?: string };

				if (!response.ok || !result.ok) {
					setFeedback(
						"error",
						result.error ??
							"No se pudo enviar el mensaje. Inténtalo de nuevo.",
					);
					resetTurnstile();
					return;
				}

				root.reset();
				restoreInitialService();
				setSubmitId();
				turnstileNeedsRefresh = true;
				setFeedback(
					"success",
					"¡Mensaje enviado! Te responderé en menos de 24 horas.",
				);
			} catch {
				setFeedback(
					"error",
					"No se pudo enviar el mensaje. Revisa tu conexión e inténtalo de nuevo.",
				);
				resetTurnstile();
			} finally {
				isSubmitting = false;
				setLoading(false);
			}
		});
	}

	function setupContactForms() {
		for (const node of document.querySelectorAll("[data-contact-form]")) {
			if (node instanceof HTMLFormElement) {
				initContactForm(node);
			}
		}
	}

	const bindContactFormLifecycle = () => {
		const win = window as Window & { __contactFormLifecycleBound?: boolean };
		if (win.__contactFormLifecycleBound) {
			return;
		}

		win.__contactFormLifecycleBound = true;
		document.addEventListener("astro:page-load", setupContactForms);
	};

	setupContactForms();
	bindContactFormLifecycle();
</script>
