---
import { contactFaqItems } from "@data/contact-faq";
---

<div class="contact-faq" data-contact-faq>
	{
		contactFaqItems.map(({ id, question, answer }, index) => (
			<div
				class="contact-faq__item"
				data-faq-item
				data-faq-last={index === contactFaqItems.length - 1 ? "true" : undefined}
			>
				<h3 class="contact-faq__heading">
					<button
						type="button"
						class="contact-faq__trigger"
						id={`faq-trigger-${id}`}
						aria-expanded="false"
						aria-controls={`faq-panel-${id}`}
						data-faq-trigger
					>
						<span class="contact-faq__question">{question}</span>
						<span
							class="contact-faq__icon i-lucide-chevron-down"
							aria-hidden="true"
						/>
					</button>
				</h3>
				<div
					id={`faq-panel-${id}`}
					class="contact-faq__panel"
					role="region"
					aria-labelledby={`faq-trigger-${id}`}
					hidden
					data-faq-panel
				>
					<div class="contact-faq__panel-inner">
						<p class="contact-faq__answer">{answer}</p>
					</div>
				</div>
			</div>
		))
	}
</div>

<style>
	.contact-faq {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--form-panel-border, rgba(var(--color-secondary), 0.12));
		border-radius: var(--radius-2xl, 1rem);
		background: rgb(var(--color-surface));
		box-shadow: 0 1px 2px rgb(var(--color-secondary) / 0.04);
	}

	.contact-faq__item {
		border-bottom: 1px solid var(--form-field-border, rgb(226 232 240));
	}

	.contact-faq__item[data-faq-last="true"] {
		border-bottom: none;
	}

	.contact-faq__heading {
		margin: 0;
	}

	.contact-faq__trigger {
		display: flex;
		width: 100%;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 14px 16px;
		border: none;
		background: transparent;
		color: rgb(var(--color-body));
		font: inherit;
		text-align: left;
		cursor: pointer;
		transition: background-color 150ms ease, color 150ms ease;
	}

	.contact-faq__trigger:hover {
		background: rgb(var(--color-neutral));
	}

	.contact-faq__trigger:focus-visible {
		outline: none;
		box-shadow: inset 0 0 0 2px rgba(var(--color-primary), 0.15);
	}

	.contact-faq__item[data-open="true"] .contact-faq__trigger {
		background: rgb(var(--color-neutral) / 0.65);
	}

	.contact-faq__question {
		font-size: 13px;
		font-weight: 500;
		line-height: 1.45;
		letter-spacing: 0.01em;
	}

	.contact-faq__icon {
		flex-shrink: 0;
		font-size: 16px;
		color: rgb(var(--color-secondary) / 0.55);
		transition: transform 200ms ease, color 150ms ease;
	}

	.contact-faq__item[data-open="true"] .contact-faq__icon {
		transform: rotate(180deg);
		color: rgb(var(--color-primary));
	}

	.contact-faq__item[data-open="true"] .contact-faq__question {
		color: rgb(var(--color-body));
	}

	.contact-faq__panel {
		display: grid;
		grid-template-rows: 0fr;
		transition:
			grid-template-rows 220ms ease,
			opacity 180ms ease;
		opacity: 0;
	}

	.contact-faq__panel[data-open="true"] {
		grid-template-rows: 1fr;
		opacity: 1;
	}

	.contact-faq__panel-inner {
		overflow: hidden;
	}

	.contact-faq__answer {
		margin: 0;
		padding: 0 16px 14px;
		color: rgb(var(--color-secondary));
		font-size: 13px;
		line-height: 1.6;
		text-wrap: pretty;
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-faq__panel,
		.contact-faq__icon,
		.contact-faq__trigger {
			transition: none;
		}
	}
</style>

<script>
	function initContactFaq(root: HTMLElement) {
		if (root.dataset.faqInitialized === "true") return;
		root.dataset.faqInitialized = "true";

		const setOpen = (item: HTMLElement, open: boolean) => {
			const trigger = item.querySelector<HTMLButtonElement>("[data-faq-trigger]");
			const panel = item.querySelector<HTMLElement>("[data-faq-panel]");
			if (!trigger || !panel) return;

			item.dataset.open = open ? "true" : "false";
			panel.dataset.open = open ? "true" : "false";
			trigger.setAttribute("aria-expanded", open ? "true" : "false");
			panel.hidden = !open;
		};

		root.addEventListener("click", (event) => {
			const trigger = (event.target as HTMLElement).closest<HTMLButtonElement>(
				"[data-faq-trigger]",
			);
			if (!trigger || !root.contains(trigger)) return;

			const item = trigger.closest<HTMLElement>("[data-faq-item]");
			if (!item) return;

			const isOpen = item.dataset.open === "true";
			setOpen(item, !isOpen);
		});
	}

	function setupContactFaqs() {
		document
			.querySelectorAll<HTMLElement>("[data-contact-faq]")
			.forEach(initContactFaq);
	}

	setupContactFaqs();
	document.addEventListener("astro:page-load", setupContactFaqs);
</script>
