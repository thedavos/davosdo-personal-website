---
import { Image } from "astro:assets";
import { isRemoteImageSrc, resolveImage } from "@/lib/project-images";

type Layout = "card" | "detail";

type Props = {
	src: string;
	alt: string;
	loading?: "eager" | "lazy";
	fetchpriority?: "high" | "low" | "auto";
	layout?: Layout;
	class?: string;
};

const {
	src,
	alt,
	loading = "lazy",
	fetchpriority,
	layout = "detail",
	class: className,
} = Astro.props;

const resolved = resolveImage(src);
const remote =
	typeof resolved === "string" && isRemoteImageSrc(resolved);

/**
 * Measured against the real layout, both inside `site-container`
 * (`max-w-[900px]` + 16px padding each side, so 868px of content):
 * - `card`   renders ~422px wide in the two-column project grid.
 * - `detail` spans the full 868px container.
 *
 * The top width in each ladder covers a 2x DPR screen without generating
 * candidates wider than the rendered layout can select.
 */
const sizes =
	layout === "card"
		? "(max-width: 640px) calc(100vw - 32px), (max-width: 932px) calc((100vw - 48px) / 2), 422px"
		: "(max-width: 932px) calc(100vw - 32px), 868px";

const widths =
	layout === "card"
		? [320, 480, 640, 844]
		: [400, 640, 868, 1200, 1400];

const imageClass = [
	"project-hero-image",
	layout === "card" && "project-hero-image--card",
	layout === "detail" && "project-hero-image--detail",
	className,
];

const imageProps = {
	alt,
	loading,
	decoding: "async" as const,
	fetchpriority,
	widths,
	sizes,
	"class:list": imageClass,
};
---

{
	typeof resolved === "string" ? (
		remote ? (
			<Image src={resolved} inferSize {...imageProps} />
		) : (
			<Image src={resolved} width={1200} height={600} {...imageProps} />
		)
	) : (
		<Image src={resolved} width={1200} height={600} {...imageProps} />
	)
}

<style>
	.project-hero-image {
		display: block;
		width: 100%;
		height: auto;
	}

	.project-hero-image--card {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.project-hero-image--detail {
		width: 100%;
		height: 100%;
		aspect-ratio: 2 / 1;
		object-fit: cover;
	}
</style>
