---
import { Image } from "astro:assets";
import { isRemoteImageSrc, resolveImage } from "@/lib/project-images";

type Layout = "card" | "detail";

type Props = {
	src: string;
	alt: string;
	loading?: "eager" | "lazy";
	fetchpriority?: "high" | "low" | "auto";
	layout?: Layout;
	class?: string;
};

const {
	src,
	alt,
	loading = "lazy",
	fetchpriority,
	layout = "detail",
	class: className,
} = Astro.props;

const resolved = resolveImage(src);
const remote =
	typeof resolved === "string" && isRemoteImageSrc(resolved);

/**
 * `detail` fills `site-column` (600px of content, 1200 at 2x).
 * `card` is the catalog thumbnail: 128px, or 88px below 480px. 256 covers
 * the larger size at 2x.
 */
const sizes =
	layout === "card"
		? "(max-width: 480px) 88px, 128px"
		: "(max-width: 640px) calc(100vw - 40px), 600px";

const widths = layout === "card" ? [88, 128, 176, 256] : [400, 600, 800, 1200];

const imageClass = [
	"project-hero-image",
	layout === "card" && "project-hero-image--card",
	layout === "detail" && "project-hero-image--detail",
	className,
];

const imageProps = {
	alt,
	loading,
	decoding: "async" as const,
	fetchpriority,
	widths,
	sizes,
	"class:list": imageClass,
};
---

{
	typeof resolved === "string" ? (
		remote ? (
			<Image src={resolved} inferSize {...imageProps} />
		) : (
			<Image src={resolved} width={1200} height={600} {...imageProps} />
		)
	) : layout === "card" ? (
		<Image
			src={resolved}
			width={256}
			height={Math.round((256 * resolved.height) / resolved.width)}
			{...imageProps}
		/>
	) : (
		<Image src={resolved} width={1200} height={600} {...imageProps} />
	)
}

<style>
	.project-hero-image {
		display: block;
		width: 100%;
		height: auto;
	}

	.project-hero-image--card {
		width: 128px;
		height: auto;
		max-height: 160px;
		object-fit: contain;
	}

	@media (max-width: 480px) {
		.project-hero-image--card {
			width: 88px;
			max-height: 110px;
		}
	}

	.project-hero-image--detail {
		width: 100%;
		height: 100%;
		aspect-ratio: 2 / 1;
		object-fit: cover;
	}
</style>
