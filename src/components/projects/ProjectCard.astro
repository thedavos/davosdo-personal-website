---
import Button from "@components/commons/Button.astro";
import Card from "@components/commons/Card.astro";
import Chip from "@components/commons/Chip.astro";
import ProjectHeroImage from "@components/projects/ProjectHeroImage.astro";

type ProjectImportance = "high" | "medium" | "low";
type ProjectCardVariant = "masonry" | "compact";

type Props = {
	title: string;
	description: string;
	tags: string[];
	importance: ProjectImportance;
	url: string;
	heroSrc?: string;
	priority?: boolean;
	colSpan?: 1 | 2;
	variant?: ProjectCardVariant;
	filterTokens?: readonly string[];
	style?: string;
	class?: string;
};

const {
	title,
	description,
	tags,
	importance,
	url,
	heroSrc,
	priority = false,
	colSpan,
	variant = "masonry",
	filterTokens = [],
	style,
	class: className,
} = Astro.props as Props;

const isCompact = variant === "compact";
const showHeroImage = Boolean(heroSrc);

const classes = [
	"project-card",
	isCompact ? "project-card--compact" : `project-card--${importance}`,
	!isCompact &&
		colSpan === 2 &&
		importance === "low" &&
		"project-card--span-wide",
	className,
]
	.filter(Boolean)
	.join(" ");
---

<div
	class={classes}
	style={style}
	data-cascade-item
	data-project-filter-tokens={filterTokens.length > 0
		? filterTokens.join(" ")
		: undefined}
>
	<Card
		as="article"
		variant="outlined"
		padding="none"
		class="service-card-surface service-card-surface-hover card-lift h-full flex flex-col"
	>
		<div class="project-card__inner">
			{
				showHeroImage && heroSrc && (
					<a href={url} class="project-card__media" tabindex="-1">
						<ProjectHeroImage
							src={heroSrc}
							alt={`Vista principal de ${title}`}
							layout="card"
							loading="eager"
							fetchpriority={priority ? "high" : undefined}
							class="project-card__image"
						/>
					</a>
				)
			}
			<div class="project-card__body">
				<div class="project-card__body-content">
					<div class="project-card__copy">
						<h3 class="project-card__title">
							<a href={url} class="project-card__title-link">{title}</a>
						</h3>
						<p class="project-card__description">{description}</p>
					</div>

					<ul
						class="project-card__tags"
						aria-label={`Herramientas usadas en ${title}`}
					>
						{tags.map((tag) => (
							<li>
								<Chip size="xs" variant="muted">
									{tag}
								</Chip>
							</li>
						))}
					</ul>
				</div>
				<div class="project-card__cta">
					<Button
						as="a"
						href={url}
						variant="ghost"
						size="sm"
						rightIcon="i-lucide-arrow-right"
					>
						Ver proyecto
					</Button>
				</div>
			</div>
		</div>
	</Card>
</div>

<style>
	.project-card {
		display: flex;
		flex-direction: column;
		box-sizing: border-box;
		min-width: 0;
	}

	.project-card[hidden] {
		display: none;
	}

	.project-card--high {
		grid-column: span 2;
		grid-row: span 2;
	}

	.project-card--medium {
		grid-column: span 2;
		grid-row: span 1;
	}

	.project-card--low {
		grid-column: span 1;
		grid-row: span 1;
	}

	.project-card--span-wide {
		grid-column: span 2;
	}

	.project-card__inner {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		gap: 16px;
		height: auto;
		min-height: 0;
		padding: 16px;
	}

	.project-card__media {
		display: block;
		flex: 0 0 auto;
		width: 128px;
		line-height: 0;
		text-decoration: none;
	}

	.project-card__media:focus-visible {
		outline: 2px solid rgb(var(--color-primary));
		outline-offset: -2px;
	}

	.project-card__media :global(img) {
		display: block;
		border-radius: var(--radius-md);
	}

	.project-card__body {
		display: flex;
		flex: 1;
		flex-direction: column;
		justify-content: space-between;
		gap: 12px;
		min-width: 0;
		padding: 0;
		height: auto;
	}

	.project-card--medium .project-card__body,
	.project-card--low .project-card__body,
	.project-card--compact .project-card__body {
		min-height: 0;
	}

	.project-card__body-content {
		display: flex;
		flex-direction: column;
		gap: 16px;
		min-width: 0;
	}

	.project-card__copy {
		display: grid;
		gap: 10px;
		min-width: 0;
	}

	.project-card__title {
		min-width: 0;
		margin: 0;
		font-size: 16px;
		font-weight: 500;
		letter-spacing: 0;
		line-height: 1.35;
		text-wrap: balance;
	}

	.project-card__title-link {
		color: inherit;
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.project-card__title-link:hover {
		color: rgb(var(--color-primary));
	}

	.project-card__cta {
		align-self: flex-end;
		line-height: 1.2;
	}

	.project-card__description {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
		margin: 0;
		color: rgb(var(--color-text-muted));
		font-size: 14px;
		line-height: 1.6;
		text-wrap: pretty;
	}

	.project-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project-card__tags li {
		display: flex;
		align-items: center;
	}

	.project-card--span-wide .project-card__description {
		-webkit-line-clamp: 3;
	}

	.project-card--medium .project-card__body {
		gap: 12px;
		padding: 0;
	}

	.project-card--medium .project-card__description {
		max-width: 52ch;
		-webkit-line-clamp: 3;
	}

	.project-card--high .project-card__body {
		flex: 1 1 auto;
		height: auto;
		gap: 12px;
		padding: 0;
	}

	.project-card--high .project-card__body-content {
		gap: 18px;
	}

	.project-card--high .project-card__copy {
		gap: 12px;
	}

	.project-card--high .project-card__title {
		max-width: none;
	}

	.project-card--high .project-card__description {
		max-width: 46ch;
		-webkit-line-clamp: 4;
	}

	.project-card--compact .project-card__body {
		min-height: 0;
		gap: 12px;
		padding: 0;
	}

	.project-card--compact .project-card__description {
		-webkit-line-clamp: 3;
	}

	@media (max-width: 900px) {
		.project-card--high,
		.project-card--medium,
		.project-card--span-wide {
			grid-column: span 2;
		}

		.project-card--low {
			grid-column: span 1;
		}

		.project-card--high {
			grid-row: span 1;
		}

		.project-card--high .project-card__inner {
			height: auto;
		}

		.project-card--high .project-card__media {
			flex: 0 0 auto;
			max-height: none;
		}

		.project-card--high .project-card__body {
			gap: 12px;
			padding: 0;
		}

		.project-card--high .project-card__title {
			max-width: none;
		}
	}

	@media (max-width: 640px) {
		.project-card--high,
		.project-card--medium,
		.project-card--low,
		.project-card--span-wide {
			grid-column: span 1;
			grid-row: span 1;
		}

		.project-card--high .project-card__inner {
			height: auto;
		}

		.project-card--high .project-card__media {
			flex: 0 0 auto;
			max-height: none;
		}

		.project-card--high .project-card__body,
		.project-card--medium .project-card__body,
		.project-card__body {
			gap: 12px;
			padding: 0;
		}

		.project-card--high .project-card__copy,
		.project-card--medium .project-card__copy,
		.project-card__copy {
			gap: 8px;
		}

		.project-card--high .project-card__description,
		.project-card--medium .project-card__description,
		.project-card--low .project-card__description,
		.project-card--compact .project-card__description,
		.project-card__description {
			-webkit-line-clamp: unset;
			overflow: visible;
		}
	}

	@media (max-width: 480px) {
		.project-card__inner {
			gap: 12px;
			padding: 12px;
		}

		.project-card__media {
			width: 88px;
		}
	}
</style>
