---
import Button from "@components/commons/Button.astro";
import SelectableChip from "@components/commons/SelectableChip.astro";
import ProjectCard from "@components/projects/ProjectCard.astro";
import {
	getProjectFilterTokens,
	projectTechnologyFilters,
	type ProjectDetail,
} from "@data/projects";

type Props = {
	projects: ProjectDetail[];
};

const { projects } = Astro.props as Props;
const initialResultLabel = `${projects.length} ${projects.length === 1 ? "proyecto" : "proyectos"}`;
---

<section
	id="proyectos"
	class="home-section home-section--surface home-projects"
	data-cascade-scope
	data-project-filter-root
>
	<div class="home-section__inner">
		<header
			class="home-section__header"
			data-cascade-item
			style="--cascade-delay: 0.04s"
		>
			<h2 class="home-section__title">Proyectos</h2>
			<p class="home-section__subtitle">
				Proyectos reales, cero maquetas. Desde flujos de automatización hasta aplicaciones web de alto rendimiento. Código optimizado y listo para escalar
			</p>
		</header>

		<div class="home-projects__content flex flex-col gap-6">
			<div
				class="home-projects__filters flex flex-col gap-4"
				data-cascade-item
				style="--cascade-delay: 0.08s"
			>
				<div class="flex flex-wrap items-center justify-between gap-3">
					<p
						id="project-filter-label"
						class="m-0 text-sm font-medium leading-snug text-body"
					>
						Filtrar por tecnología
						<span class="font-normal text-muted">
							·
							<span
								data-project-filter-count
								aria-live="polite"
								aria-atomic="true"
							>
								{initialResultLabel}
							</span>
						</span>
					</p>
					<Button
						variant="ghost"
						size="sm"
						leftIcon="i-lucide-x"
						class="-mr-3"
						data-project-filter-clear
						hidden
					>
						Limpiar filtros
					</Button>
				</div>

				<div
					class="flex flex-wrap gap-2"
					role="group"
					aria-labelledby="project-filter-label"
				>
					{
						projectTechnologyFilters.map((filter) => (
							<SelectableChip
								value={filter.value}
								data-filter-tokens={filter.tokens.join(" ")}
								aria-controls="project-grid"
							>
								{filter.label}
							</SelectableChip>
						))
					}
				</div>
			</div>

			<div
				id="project-grid"
				class="home-projects__grid"
				aria-label="Proyectos destacados"
				data-project-filter-grid
			>
				{
					projects.map((project, index) => (
						<ProjectCard
							title={project.title}
							description={project.description}
							tags={project.tags}
							importance={project.importance}
							heroSrc={
								project.importance === "high"
									? project.images.hero
									: undefined
							}
							colSpan={project.colSpan}
							filterTokens={getProjectFilterTokens(project)}
							url={`/projects/${project.slug}`}
							style={`--cascade-delay: ${0.12 + index * 0.04}s`}
						/>
					))
				}
			</div>

			<div
				class="home-projects__empty px-6 py-10"
				data-project-filter-empty
				hidden
			>
				<h3 class="m-0 text-lg leading-tight text-body">
					No hay proyectos con esos filtros
				</h3>
				<p class="mb-0 mt-2 max-w-[44ch] text-sm leading-relaxed text-muted">
					Prueba otra combinación de tecnologías o limpia los filtros para ver
					todos los proyectos.
				</p>
			</div>
		</div>
	</div>
</section>

<style>
	.home-projects__grid {
		display: grid;
		grid-auto-flow: dense;
		grid-auto-rows: minmax(152px, auto);
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 20px;
		align-items: stretch;
	}

	:global([data-project-filter-clear][hidden]),
	.home-projects__empty[hidden] {
		display: none;
	}

	@media (max-width: 900px) {
		.home-projects__grid {
			grid-auto-rows: minmax(152px, auto);
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.home-projects__grid {
			grid-auto-rows: auto;
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	import { setupProjectFilters } from "@/utils/project-filter";
	setupProjectFilters();
</script>
