---
import Timeline from "@components/experience/Timeline.astro";
import type { ExperienceItem } from "@data/experience";

type Props = {
	items: ExperienceItem[];
};

const { items } = Astro.props as Props;
---

<section id="experiencia" class="home-section home-experience" data-cascade-scope>
	<header
		class="home-section__header"
		data-cascade-item
		style="--cascade-delay: 0.04s"
	>
		<h2 class="home-section__title">Experiencia</h2>
		<p class="home-section__subtitle">
			Siete años construyendo aplicaciones web y móviles sólidas. Me enfoco en el rendimiento, código mantenible que envejece bien y decisiones técnicas claras que facilitan el trabajo de todo el equipo
		</p>
	</header>

	<Timeline
		items={items}
		ariaLabel="Experiencia laboral de David Vargas"
		class="home-experience__timeline"
	/>
</section>

<style>
	.home-experience {
		display: flex;
		flex-direction: column;
		gap: 64px;
	}

	.home-experience__timeline {
		margin-top: 4px;
	}

	@media (max-width: 760px) {
		.home-experience {
			gap: 32px;
		}
	}
</style>
