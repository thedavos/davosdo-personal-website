---
import Button from "@components/commons/Button.astro";
import SocialLinks from "@components/commons/SocialLinks.astro";
import HomeHeroTrust from "@components/home/HomeHeroTrust.astro";
---

<section id="sobre-mi" class="home-hero" data-cascade-scope>
	<div class="home-hero__inner site-container">
		<p
			class="home-hero__eyebrow"
			data-cascade-item
			style="--cascade-delay: 0.04s"
		>
			Hola, soy
		</p>
		<h1
			class="home-hero__title"
			data-cascade-item
			style="--cascade-delay: 0.08s"
		>
			David Vargas Dominguez
		</h1>
		<p
			class="home-hero__role"
			data-cascade-item
			style="--cascade-delay: 0.12s"
		>
			Senior Software Engineer
		</p>
		<p
			class="home-hero__copy"
			data-cascade-item
			style="--cascade-delay: 0.16s"
		>
			Construyo productos web listos para producción, con foco en interfaces
			rápidas, lógica de servidor sólida y despliegue optimizado.
		</p>

		<div
			class="home-hero__actions"
			data-cascade-item
			style="--cascade-delay: 0.20s"
		>
			<Button
				href="#proyectos"
				size="sm"
				rightIcon="i-lucide-arrow-right"
				data-no-swup
			>
				Ver qué construí
			</Button>
			<Button href="/experience" variant="ghost" size="sm">
				Ver trayectoria
			</Button>
		</div>

		<SocialLinks
			class="home-hero__social"
			data-cascade-item
			style="--cascade-delay: 0.24s"
		/>

		<div
			data-cascade-item
			style="--cascade-delay: 0.28s"
		>
			<HomeHeroTrust />
		</div>
	</div>
</section>

<style>
	.home-hero {
		box-sizing: border-box;
		position: relative;
		display: flex;
		width: 100%;
		min-height: calc(100svh - 61px);
		flex-direction: column;
		justify-content: center;
		padding: 40px 0 56px;
		background: rgb(var(--color-background));
	}

	.home-hero::after {
		content: "";
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		height: 1px;
		background: rgb(var(--color-border));
	}

	.home-hero__inner {
		display: flex;
		flex-direction: column;
	}

	.home-hero__eyebrow {
		margin: 0 0 8px;
		font-size: 15px;
		font-weight: 400;
		line-height: 1.4;
		color: rgb(var(--color-text-muted));
	}

	.home-hero__title {
		max-width: 12ch;
		margin: 0 0 10px;
		text-align: left;
		font-size: clamp(2.75rem, 8vw, 4.5rem);
		font-weight: 700;
		line-height: 0.98;
		letter-spacing: 0;
	}

	.home-hero__role {
		max-width: 24ch;
		margin: 0 0 20px;
		font-size: 18px;
		font-weight: 400;
		line-height: 1.35;
		color: rgb(var(--color-text-muted));
	}

	.home-hero__copy {
		max-width: 52ch;
		margin: 0 0 28px;
		text-align: left;
		font-size: 17px;
		font-weight: 400;
		line-height: 1.6;
		color: rgb(var(--color-body));
	}

	.home-hero__actions {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 12px;
		margin-bottom: 20px;
	}

	.home-hero__social {
		display: flex;
		max-width: 100%;
		flex-wrap: wrap;
		justify-content: flex-start;
		gap: 12px 8px;
		margin-bottom: 28px;
	}

	@media (min-width: 768px) {
		.home-hero {
			min-height: calc(100svh - 72px);
			padding: 56px 0 80px;
		}

		.home-hero__title {
			font-size: 72px;
		}

		.home-hero__role {
			margin-bottom: 24px;
			font-size: 20px;
		}

		.home-hero__copy {
			margin-bottom: 32px;
			font-size: 18px;
		}

		.home-hero__actions {
			flex-direction: row;
			flex-wrap: wrap;
			align-items: center;
			margin-bottom: 24px;
		}

		.home-hero__social {
			max-width: 52ch;
			gap: 16px 12px;
			margin-bottom: 36px;
		}
	}
</style>
