---
import Button from "@components/commons/Button.astro";
import SocialLinks from "@components/commons/SocialLinks.astro";
---

<section id="sobre-mi" class="home-hero" data-cascade-scope>
	<p
		class="home-hero__eyebrow"
		data-cascade-item
		style="--cascade-delay: 0.04s"
	>
		Hola, soy
	</p>
	<h1
		class="home-hero__title"
		data-cascade-item
		style="--cascade-delay: 0.08s"
	>
		David Vargas Dominguez
	</h1>
	<h2
		class="home-hero__subtitle"
		data-cascade-item
		style="--cascade-delay: 0.12s"
	>
		Senior Software Engineer
	</h2>
	<p
		class="home-hero__copy"
		data-cascade-item
		style="--cascade-delay: 0.16s"
	>
		Creo productos listos para producción. Me encargo de diseñar interfaces de usuario rápidas, construir lógica de servidor sólida y asegurar un despliegue optimizado
	</p>

	<div
		class="home-hero__actions"
		data-cascade-item
		style="--cascade-delay: 0.20s"
	>
		<Button
			href="#proyectos"
			size="sm"
			rightIcon="i-lucide-arrow-right"
			data-no-swup
		>
			Ver qué construí
		</Button>
		<Button href="#servicios" variant="ghost" data-no-swup>
			Ver servicios
		</Button>
	</div>

	<SocialLinks
		class="home-hero__social"
		data-cascade-item
		style="--cascade-delay: 0.24s"
	/>
</section>

<style>
	.home-hero {
		box-sizing: border-box;
		display: flex;
		min-height: calc(100svh - 61px);
		flex-direction: column;
		justify-content: center;
		padding: 40px 0 56px;
	}

	.home-hero__eyebrow {
		display: none;
		margin: 0 0 8px;
		font-size: 16px;
		font-weight: 500;
		line-height: 1.4;
	}

	.home-hero__title {
		max-width: 12ch;
		margin: 0 0 12px;
		text-align: left;
		font-size: 42px;
		font-weight: 700;
		line-height: 0.98;
		letter-spacing: 0;
	}

	.home-hero__subtitle {
		max-width: 18ch;
		margin: 0 0 16px;
		text-align: left;
		font-size: 24px;
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: 0;
	}

	.home-hero__copy {
		max-width: 62ch;
		margin: 0 0 24px;
		text-align: left;
		font-size: 17px;
		font-weight: 400;
		line-height: 1.6;
	}

	.home-hero__actions {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 12px;
		margin-bottom: 16px;
	}

	.home-hero__social {
		display: flex;
		max-width: 100%;
		flex-wrap: wrap;
		justify-content: flex-start;
		gap: 12px 8px;
	}

	@media (min-width: 768px) {
		.home-hero {
			min-height: calc(100svh - 72px);
			padding: 56px 0 80px;
		}

		.home-hero__eyebrow {
			display: block;
		}

		.home-hero__title {
			font-size: 72px;
			letter-spacing: 0;
		}

		.home-hero__subtitle {
			margin-bottom: 20px;
			font-size: 32px;
			line-height: 1.12;
		}

		.home-hero__copy {
			margin-bottom: 28px;
			font-size: 19px;
		}

		.home-hero__actions {
			flex-direction: row;
			flex-wrap: wrap;
			align-items: center;
			gap: 12px;
			margin-bottom: 20px;
		}

		.home-hero__social {
			max-width: 62ch;
			gap: 16px 12px;
		}
	}
</style>
