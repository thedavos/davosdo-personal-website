---
import { env } from "cloudflare:workers";
import ContactFaq from "@components/contact/ContactFaq.astro";
import ContactForm from "@components/contact/ContactForm.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { getServiceBySlug } from "@data/services";

export const prerender = false;

const serviceParam = Astro.url.searchParams.get("service") ?? "";
const serviceSlug = getServiceBySlug(serviceParam)?.slug ?? "";

const turnstileSiteKey = env.PUBLIC_TURNSTILE_SITE_KEY?.trim() ?? "";
---

<PageLayout
	showFooter
	title="Contacto | davosdo.dev"
	description="Cuéntame sobre tu idea. Respondo en menos de 24 horas."
	containerClass="w-full max-w-[980px] mx-auto px-4 py-12"
>
	<section class="contact-page" data-cascade-scope>
		<header
			class="contact-page__hero"
			data-cascade-item
			style="--cascade-delay: 0.04s"
		>
			<h1 class="contact-page__title">Contacto</h1>
		</header>

		<div class="contact-page__layout">
			<section
				class="contact-page__section contact-page__section--faq order-1 lg:order-2"
				data-cascade-item
				style="--cascade-delay: 0.08s"
				aria-labelledby="contact-faq-title"
			>
				<h2 class="contact-page__section-title" id="contact-faq-title">
					Preguntas frecuentes
				</h2>
				<ContactFaq />
			</section>

			<section
				class="contact-page__section contact-page__section--form order-2 lg:order-1"
				data-cascade-item
				style="--cascade-delay: 0.12s"
				aria-labelledby="contact-form-title"
			>
				<h2 class="contact-page__form-title" id="contact-form-title">
					Cuéntame sobre tu idea. Ya sea una app, un bot, una plataforma web o
					una automatización. Te respondo en menos de 24h.
				</h2>
				<ContactForm
					selectedService={serviceSlug}
					turnstileSiteKey={turnstileSiteKey}
				/>
			</section>
		</div>
	</section>
</PageLayout>

<style>
	.contact-page {
		display: flex;
		flex-direction: column;
		gap: 64px;
	}

	.contact-page__layout {
		display: grid;
		grid-template-columns: 1fr;
		gap: 40px;
		align-items: start;
	}

	@media (min-width: 1024px) {
		.contact-page__layout {
			grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
			gap: 48px;
		}
	}

	.contact-page__hero {
		max-width: 680px;
		margin: 0 auto;
		text-align: center;
	}

	.contact-page__title {
		margin: 0;
		font-size: 64px;
		line-height: 0.98;
		letter-spacing: -0.03em;
	}

	.contact-page__section {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	.contact-page__section-title {
		margin: 0;
		font-size: 13px;
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgb(var(--color-secondary) / 0.85);
	}

	.contact-page__form-title {
		margin: 0;
		max-width: 42ch;
		color: rgb(var(--color-secondary));
		font-size: 17px;
		font-weight: 400;
		line-height: 1.55;
		letter-spacing: -0.01em;
		text-wrap: pretty;
	}

	@media (max-width: 760px) {
		.contact-page {
			gap: 36px;
		}

		.contact-page__layout {
			gap: 32px;
		}

		.contact-page__hero {
			max-width: none;
			margin: 0;
			text-align: left;
		}

		.contact-page__title {
			font-size: 42px;
			line-height: 1;
		}

		.contact-page__section-title {
			font-size: 24px;
		}

		.contact-page__form-title {
			font-size: 18px;
		}
	}
</style>
