---
import Button from "@components/commons/Button.astro";
import KeyboardPageNav from "@components/commons/KeyboardPageNav.astro";
import SocialLinks from "@components/commons/SocialLinks.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { SITE_TITLE, SITE_DESCRIPTION, SITE_NAV_ITEMS } from "@/consts";

const currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");
---

<PageLayout
	title={SITE_TITLE}
	description={SITE_DESCRIPTION}
	centerContent={true}
>
	<p class="mb-2 hidden md:block text-base font-medium leading-[1.4]">Hola, soy</p>
	<h1
		class="mb-2.5 text-center m-auto md:m-none md:text-left max-w-[12ch] text-[42px] font-bold leading-[0.98] tracking-[-0.03em] md:mb-3 md:text-[72px] md:tracking-[-0.04em]"
	>
		David Vargas Domínguez
	</h1>
	<h2
		class="mb-4 hidden max-w-[18ch] text-2xl font-semibold leading-[1.15] tracking-[-0.02em] md:mb-5 md:block md:text-[32px] md:leading-[1.12]"
	>
		Tú tienes la idea, yo la hago funcionar
	</h2>
	<h2
		class="mb-4 block text-center m-auto max-w-[18ch] text-2xl font-semibold leading-[1.15] tracking-[-0.02em] md:mb-5 md:hidden md:text-[32px] md:leading-[1.12]"
	>
		Full-Stack Software Engineer
	</h2>
	<p class="mb-6 text-center m-auto md:m-none md:text-left max-w-[62ch] text-[17px] font-normal leading-[1.6] md:mb-7 md:text-[19px]">
		Desarrollo productos web completos: la interfaz, la lógica, el servidor y el deploy. Todo lo que necesita una idea para existir en internet, en un solo lugar.
	</p>

	<div class="mb-4 flex flex-col items-stretch gap-2.5 md:mb-5 md:flex-row md:flex-wrap md:gap-3">
		<Button href="/projects" rightIcon="i-lucide-arrow-right">Ver qué construí</Button>
		<Button href="/services" variant="ghost">Ver servicios</Button>
	</div>

	<SocialLinks
		class="flex flex-wrap justify-center gap-x-2 gap-y-3 max-w-full md:justify-initial md:gap-x-2.5 md:gap-y-3.5 md:max-w-[62ch]"
	/>

	<KeyboardPageNav navItems={SITE_NAV_ITEMS} currentPath={currentPath} />
</PageLayout>
