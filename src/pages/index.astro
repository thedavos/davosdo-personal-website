---
import { env } from "cloudflare:workers";
import HomeBlog from "@components/home/HomeBlog.astro";
import HomeContact from "@components/home/HomeContact.astro";
import HomeFaq from "@components/home/HomeFaq.astro";
import HomeHero from "@components/home/HomeHero.astro";
import HomeProjects from "@components/home/HomeProjects.astro";
import HomeServices from "@components/home/HomeServices.astro";
import PageLayout from "@layouts/PageLayout.astro";
import "@styles/home.css";
import { SITE_DESCRIPTION, SITE_TITLE } from "@/consts";
import { getVisibleProjects } from "@data/projects";
import { getServiceBySlug, services } from "@data/services";

export const prerender = false;

const serviceParam = Astro.url.searchParams.get("service") ?? "";
const serviceSlug = getServiceBySlug(serviceParam)?.slug ?? "";
const visibleProjects = getVisibleProjects();
const disableTurnstile =
	env.PUBLIC_DISABLE_TURNSTILE === "true" ||
	import.meta.env.PUBLIC_DISABLE_TURNSTILE === "true";
const turnstileSiteKey = disableTurnstile
	? ""
	: env.PUBLIC_TURNSTILE_SITE_KEY?.trim() ?? "";
---

<PageLayout
	showFooter
	title={SITE_TITLE}
	description={SITE_DESCRIPTION}
	containerClass="home-page py-0"
>
	{
		/* The contact form injects the Turnstile script on demand, and warming
		   the connection removes DNS and TLS from the critical path at submit
		   time. This lives on the page rather than in the layout because the form
		   only exists here. In the layout it made every blog, project and
		   experience page open a TLS connection for a widget they never load. */
		!disableTurnstile && (
			<link
				slot="head"
				rel="preconnect"
				href="https://challenges.cloudflare.com"
				crossorigin
			/>
		)
	}
	<HomeHero />
	<HomeProjects projects={visibleProjects} />
	<HomeServices services={services} />
	<HomeBlog />
	<HomeFaq />
	<HomeContact
		selectedService={serviceSlug}
		turnstileSiteKey={turnstileSiteKey}
		disableTurnstile={disableTurnstile}
	/>
</PageLayout>
