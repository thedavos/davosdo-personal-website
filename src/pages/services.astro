---
import ServicesExplorer from "@components/services/ServicesExplorer.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { services } from "@data/services";
---

<PageLayout
	showFooter
	title="Servicios | davosdo.dev"
	description="Servicios de desarrollo frontend, arquitectura web y experiencia de usuario."
	containerClass="w-full max-w-[980px] mx-auto px-4 py-12"
>
	<section class="services" data-cascade-scope>
		<h1
			class="services__title"
			data-cascade-item
			style="--cascade-delay: 0.04s"
		>
			¿En qué te puedo ayudar?
		</h1>

		<p
			class="services__subtitle"
			data-cascade-item
			style="--cascade-delay: 0.06s"
		>
			Desde la idea hasta el deploy. Trabajo con startups, negocios y emprendedores para construir productos digitales que escalan.
		</p>

		<ServicesExplorer services={services} />
	</section>
</PageLayout>

<style>
	.services__title {
		font-size: 64px;
		line-height: 0.98;
		letter-spacing: -0.03em;
		margin-bottom: 16px;
		text-align: left;
	}

	.services__subtitle {
		max-width: 50ch;
		color: var(--color-text-muted);
		font-size: 20px;
		line-height: 1.5;
		text-align: left;
		margin-bottom: 48px;
	}

	@media (min-width: 760px) {
		.services__title {
			text-align: center;
		}

		.services__subtitle {
			text-align: center;
			margin: auto auto 48px;
		}
	}

	@media (max-width: 760px) {
		.services {
			gap: 24px;
		}

		.services__title {
			font-size: 42px;
			line-height: 1;
		}

		.services__subtitle {
			font-size: 18px;
		}
	}
</style>
