---
import BlogArchiveGrid from "@components/blog/BlogArchiveGrid.astro";
import BlogFeaturedCard from "@components/blog/BlogFeaturedCard.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { getCollection } from "astro:content";
import { enrichPost, sortPostsByDate } from "@/lib/blog";

const posts = sortPostsByDate(await getCollection("blog"));
const featured = posts[0];
const archivePosts = posts.slice(1);
const featuredEnriched = featured ? enrichPost(featured) : undefined;
---

<PageLayout
	title="Blog | todos los artículos | davosdo.dev"
	description="Archivo completo de artículos del blog."
	containerClass="site-container py-12"
	showFooter={true}
>
	<section class="blog-all-page" data-cascade-scope>
		<header
			class="blog-all-page__hero"
			data-cascade-item
			style="--cascade-delay: 0.04s"
		>
			<h1 class="blog-all-page__title">Todos los artículos</h1>
			<p class="blog-all-page__subtitle">
				Archivo completo ordenado por fecha, del más reciente al más
				antiguo.
			</p>
		</header>

		{
			featuredEnriched ? (
				<div data-cascade-item style="--cascade-delay: 0.1s">
					<BlogFeaturedCard
						post={featuredEnriched.post}
						readingTimeLabel={featuredEnriched.readingTimeLabel}
						url={featuredEnriched.url}
						layout="horizontal"
						priority
					/>
				</div>
			) : (
				<p class="blog-all-page__empty">Aún no hay artículos publicados.</p>
			)
		}

		{
			archivePosts.length > 0 && (
				<section
					class="blog-all-page__archive"
					aria-labelledby="blog-archive-heading"
					data-cascade-item
					style="--cascade-delay: 0.16s"
				>
					<div class="blog-all-page__archive-header">
						<h2 id="blog-archive-heading" class="blog-all-page__archive-title">
							Más artículos
						</h2>
						<p class="blog-all-page__archive-lead">
							El resto del archivo, ordenado del más reciente al más
							antiguo.
						</p>
					</div>
					<BlogArchiveGrid posts={archivePosts} />
				</section>
			)
		}
	</section>
</PageLayout>

<style>
	.blog-all-page {
		display: flex;
		flex-direction: column;
		gap: 40px;
	}

	.blog-all-page__hero {
		max-width: 720px;
		margin: 0 auto;
		text-align: center;
	}

	.blog-all-page__title {
		margin: 0 0 16px;
		font-size: 56px;
		letter-spacing: 0;
		line-height: 1;
	}

	.blog-all-page__subtitle {
		max-width: 58ch;
		margin: 0 auto;
		color: rgb(var(--color-text-muted));
		font-size: 18px;
		line-height: 1.55;
		text-wrap: pretty;
	}

	.blog-all-page__archive {
		display: flex;
		flex-direction: column;
		gap: 24px;
		padding-top: 8px;
		border-top: 1px solid var(--form-panel-border);
	}

	.blog-all-page__archive-header {
		display: grid;
		gap: 8px;
		max-width: 52ch;
	}

	.blog-all-page__archive-title {
		margin: 0;
		font-size: 22px;
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.15;
		color: rgb(var(--color-text));
	}

	.blog-all-page__archive-lead {
		margin: 0;
		color: rgb(var(--color-text-muted));
		font-size: 15px;
		line-height: 1.55;
		text-wrap: pretty;
	}

	.blog-all-page__archive :global(.blog-archive-grid) {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 24px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.blog-all-page__archive :global(.blog-archive-grid__item) {
		display: flex;
		min-width: 0;
	}

	@media (max-width: 900px) {
		.blog-all-page__archive :global(.blog-archive-grid) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.blog-all-page__archive :global(.blog-archive-grid) {
			grid-template-columns: 1fr;
			gap: 12px;
		}
	}

	.blog-all-page__empty {
		margin: 0;
		color: rgb(var(--color-text-muted));
		text-align: center;
	}

	@media (max-width: 760px) {
		.blog-all-page__hero {
			max-width: none;
			margin: 0;
			text-align: left;
		}

		.blog-all-page__subtitle {
			margin: 0;
		}

		.blog-all-page__archive-header {
			max-width: none;
		}
	}

	@media (max-width: 640px) {
		.blog-all-page {
			gap: 32px;
		}

		.blog-all-page__title {
			font-size: 38px;
		}

		.blog-all-page__archive-title {
			font-size: 20px;
		}

		.blog-all-page__archive-lead {
			font-size: 14px;
		}
	}
</style>
