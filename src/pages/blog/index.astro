---
import Button from "@components/commons/Button.astro";
import BlogGrid from "@components/blog/BlogGrid.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { getCollection } from "astro:content";
import { getFeaturedAndRecent } from "@/lib/blog";

const posts = await getCollection("blog");
const { featured, recent } = getFeaturedAndRecent(posts);
---

<PageLayout
	title="Blog | davosdo.dev"
	description="Artículos sobre desarrollo, producto y tecnología."
	containerClass="w-full max-w-[1080px] mx-auto px-4 py-12"
	showFooter={true}
>
	<section class="blog-page" data-cascade-scope>
		<header
			class="blog-page__hero"
			data-cascade-item
			style="--cascade-delay: 0.04s"
		>
			<h1 class="blog-page__title">Blog</h1>
			<p class="blog-page__subtitle">
				Notas sobre desarrollo, herramientas y lo que voy aprendiendo en
				proyectos reales.
			</p>
		</header>

		{
			featured ? (
				<BlogGrid featured={featured} recent={recent} />
			) : (
				<p class="blog-page__empty">Aún no hay artículos publicados.</p>
			)
		}

		{
			featured && (
				<div
					class="blog-page__cta"
					data-cascade-item
					style="--cascade-delay: 0.28s"
				>
					<Button
						as="a"
						href="/blog/all"
						variant="outline"
						size="md"
						rightIcon="i-lucide-arrow-right"
					>
						Ver posts
					</Button>
				</div>
			)
		}
	</section>
</PageLayout>

<style>
	.blog-page {
		display: flex;
		flex-direction: column;
		gap: 44px;
	}

	.blog-page__hero {
		max-width: 720px;
		margin: 0 auto;
		text-align: center;
	}

	.blog-page__title {
		margin: 0 0 16px;
		font-size: 64px;
		letter-spacing: 0;
		line-height: 1;
	}

	.blog-page__subtitle {
		max-width: 58ch;
		margin: 0 auto;
		color: var(--color-text-muted);
		font-size: 20px;
		line-height: 1.55;
		text-wrap: pretty;
	}

	.blog-page__cta {
		display: flex;
		justify-content: center;
	}

	.blog-page__empty {
		margin: 0;
		color: var(--color-text-muted);
		text-align: center;
	}

	@media (max-width: 760px) {
		.blog-page__hero {
			max-width: none;
			margin: 0;
			text-align: left;
		}

		.blog-page__subtitle {
			margin: 0;
		}
	}

	@media (max-width: 640px) {
		.blog-page {
			gap: 32px;
		}

		.blog-page__title {
			font-size: 42px;
		}

		.blog-page__subtitle {
			font-size: 18px;
		}
	}
</style>
