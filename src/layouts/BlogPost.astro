---
import type { CollectionEntry } from "astro:content";
import { Picture } from "astro:assets";
import PageLayout from "@layouts/PageLayout.astro";
import FormattedDate from "@components/FormattedDate.astro";
import "@styles/blog.css";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<PageLayout
	title={`${title} | davosdo.dev`}
	description={description}
	containerClass="site-container py-8 md:py-12"
	showFooter
>
	<article class="blog-post">
		{
			heroImage && (
				<figure class="blog-post__hero">
					{heroImage.format === "svg" ? (
						<img
							class="blog-post__hero-image"
							src={heroImage.src}
							alt=""
							width={heroImage.width}
							height={heroImage.height}
							loading="eager"
							fetchpriority="high"
							decoding="async"
						/>
					) : (
						<Picture
							class="blog-post__hero-image"
							src={heroImage}
							alt=""
							formats={["avif"]}
							fallbackFormat="webp"
							width={1020}
							widths={[400, 720, 1020, 1400]}
							sizes="(max-width: 1020px) 100vw, 1020px"
							loading="eager"
							fetchpriority="high"
							decoding="async"
						/>
					)}
				</figure>
			)
		}

		<header class="blog-post__header">
			<p class="blog-post__meta">
				<FormattedDate date={pubDate} />
				{
					updatedDate && (
						<>
							{" · "}
							<span>
								Actualizado el <FormattedDate date={updatedDate} />
							</span>
						</>
					)
				}
			</p>
			<h1 class="blog-post__title">{title}</h1>
			<hr class="blog-post__divider" />
		</header>

		<div class="blog-post__content">
			<slot />
		</div>
	</article>
</PageLayout>
