---
import BaseHead from "@components/BaseHead.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import SwupCascadeScript from "@components/SwupCascadeScript.astro";
import GlobalKeyboardPageNav from "@components/commons/GlobalKeyboardPageNav.astro";

interface Props {
	title: string;
	description: string;
	lang?: string;
	containerClass?: string;
	centerContent?: boolean;
	showFooter?: boolean;
}

const {
	title,
	description,
	lang = "es",
	containerClass = "w-full max-w-[720px] lg:max-w-[1024px] mx-auto px-4 py-12",
	centerContent = false,
	showFooter = false,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} />
		<slot name="head" />
	</head>
	<body>
		<a href="#main-content" class="skip-link">Saltar al contenido principal</a>
		<Header />
		<div
			id="swup-container"
			class="min-h-[calc(100vh-61px)] flex flex-col transition-swup-slide md:min-h-[calc(100vh-72px)]"
		>
			<main
				id="main-content"
				tabindex="-1"
				class:list={["flex w-full min-w-0 flex-1 flex-col", centerContent && "items-center"]}
			>
				<div class={containerClass}>
					<slot />
				</div>
			</main>
			{showFooter && <Footer />}
		</div>
		<SwupCascadeScript />
		<GlobalKeyboardPageNav />
	</body>
</html>
