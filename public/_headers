# Build output is content-hashed (see `assetFileNames` in astro.config.mjs),
# so the filename changes whenever the content does. Safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Assets copied verbatim from `public/`. These filenames are stable, so they
# cannot be immutable, but the default of `max-age=0, must-revalidate` forces a
# revalidation round-trip on every visit.
/favicon.svg
  Cache-Control: public, max-age=86400
/og-image.png
  Cache-Control: public, max-age=86400
/logos/*
  Cache-Control: public, max-age=86400
/blog/misgastos-workflow/misgastos-workflow.json
  Cache-Control: public, max-age=86400
