{
	"name": "davosdo-personal-website",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	},
	"send_email": [
		{
			"name": "SEND_EMAIL",
			"destination_address": "hola@davosdo.dev"
		}
	],
	"vars": {
		"CONTACT_FROM_EMAIL": "contacto@davosdo.dev",
		"CONTACT_TO_EMAIL": "hola@davosdo.dev",
		"PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAADWPq4baKHGPGw1Z"
	},
	"upload_source_maps": true,
	"workers_dev": false,
	"routes": [
	{
		"pattern": "davosdo.dev",
		"custom_domain": true
	},
	{
		"pattern": "www.davosdo.dev",
		"custom_domain": true
	}
  ]
}
